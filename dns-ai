    try:
        fd, tmp = tempfile.mkstemp(prefix=".dns-ai-update-", dir=str(target.parent))
        with os.fdopen(fd, "wb") as fh:
            fh.write(payload)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, 0o755)
        os.replace(tmp, target)
        fsync_dir(str(target.parent))
        print(f"{C_GREEN}✓ Программа успешно обновлена до актуальной версии!{C_RESET}")
