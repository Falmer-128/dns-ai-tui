#   2. geohide-us  - GeoHide USA (All AI routed via US IP)
#   3. geohide-ru  - GeoHide Russia (Bypasses foreign blocking of Russian sites)
#   4. dns-ai      - DNS-AI (DoT dns.dns-ai.ru, Swedish SNI for ChatGPT/Claude)

# Default Fallback Server Endpoints
DNS_AI_TLS_NAME="dns.dns-ai.ru"
