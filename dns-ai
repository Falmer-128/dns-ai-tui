# ----------------- NetworkManager & Resolved Routing -----------------
has_global_v6() {
    ip -6 route show default 2>/dev/null | grep -q default
}

nm_apply_ignore_dns() {
    command -v nmcli >/dev/null 2>&1 || return 0
    systemctl is-active --quiet NetworkManager 2>/dev/null || return 0
    mkdir -p "$CACHE_DIR"

    nmcli -t -f UUID,TYPE,DEVICE connection show --active 2>/dev/null | while IFS=: read -r uuid type dev; do
        case "$type" in
            loopback|bridge|tun|wireguard|vpn|*docker*|dummy|"") continue ;;
        esac
        nmcli connection modify "$uuid" ipv4.ignore-auto-dns yes ipv6.ignore-auto-dns yes 2>/dev/null || continue
        grep -qx "$uuid" "$CACHE_DIR/nm-connections" 2>/dev/null || printf '%s\n' "$uuid" >> "$CACHE_DIR/nm-connections"
        [ -n "$dev" ] && nmcli device reapply "$dev" 2>/dev/null || true
    done
}

nm_restore_dns() {
    command -v nmcli >/dev/null 2>&1 || return 0
    systemctl is-active --quiet NetworkManager 2>/dev/null || return 0
    if [ -s "$CACHE_DIR/nm-connections" ]; then
        while read -r uuid; do
            nmcli connection modify "$uuid" ipv4.ignore-auto-dns no ipv6.ignore-auto-dns no 2>/dev/null || continue
            dev=$(nmcli -g GENERAL.DEVICES connection show "$uuid" 2>/dev/null || true)
            [ -n "$dev" ] && nmcli device reapply "$dev" 2>/dev/null || true
        done < "$CACHE_DIR/nm-connections"
        rm -f "$CACHE_DIR/nm-connections"
    fi
}

enable_dns() {
    local custom_profile="$1"
    [ -n "$custom_profile" ] && set_active_profile "$custom_profile"

    local current_prof
    current_prof=$(get_active_profile)
    local tls_name
    tls_name=$(get_profile_tls_name "$current_prof")

    echo -e "${C_CYAN}--> [DNS-AI] Активация профиля:${C_RESET} ${C_BOLD}$(get_profile_name "$current_prof")${C_RESET}"

    # Ensure /etc/resolv.conf points to systemd-resolved stub
    if [ -f /run/systemd/resolve/stub-resolv.conf ]; then
        ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf 2>/dev/null || true
    fi

    local ips
    ips=$(get_profile_dns_servers "$current_prof")
    local v4
    v4=$(echo "$ips" | cut -d'|' -f1)
    local v6
    v6=$(echo "$ips" | cut -d'|' -f2)

    local dns_entries=""
    for ip in $v4; do
        [ -n "$ip" ] && dns_entries="$dns_entries $ip#$tls_name"
    done
    if has_global_v6 && [ -n "$v6" ]; then
        for ip in $v6; do
            [ -n "$ip" ] && dns_entries="$dns_entries $ip#$tls_name"
        done
    fi

    cat << CONF > "$CONFIG_FILE"
# DNS-AI & GeoHide — systemd-resolved configuration
# Generated on: $(date '+%Y-%m-%d %H:%M:%S')
[Resolve]
DNS=${dns_entries# }
DNSOverTLS=yes
Domains=~.
FallbackDNS=1.1.1.1 8.8.8.8
DNSSEC=no
CONF

    # Prevent NetworkManager from pushing ISP/DHCP DNS to per-interface resolvers
    nm_apply_ignore_dns

    systemctl restart systemd-resolved 2>/dev/null || true
    resolvectl flush-caches 2>/dev/null || true

    # Resolve and inject AI SNI proxies
    echo -e "${C_CYAN}--> Проверка и выбор живых SNI узлов для нейросетей...${C_RESET}"
    local google_ip openai_ip
    google_ip=$(determine_google_sni_ip)
    openai_ip=$(determine_openai_sni_ip)

    update_hosts_entry "$google_ip" "$openai_ip"

    echo -e "${C_GREEN}✓ Защищенный DNS ($tls_name) активирован глобально!${C_RESET}"
    if [ -n "$google_ip" ]; then
        echo -e "${C_GREEN}✓ Google AI / Antigravity направлены на:${C_RESET} ${C_WHITE}$google_ip${C_RESET}"
    fi
    if [ -n "$openai_ip" ]; then
        echo -e "${C_GREEN}✓ ChatGPT / Claude AI направлены на:${C_RESET} ${C_WHITE}$openai_ip${C_RESET}"
    fi
}

disable_dns() {
    rm -f "$CONFIG_FILE"
    sed -i '/# BEGIN DNS-AI-HOSTS/,/# END DNS-AI-HOSTS/d' "$HOSTS_FILE" 2>/dev/null || true

    nm_restore_dns

    systemctl restart systemd-resolved 2>/dev/null || true
    resolvectl flush-caches 2>/dev/null || true
    echo -e "${C_YELLOW}✓ DNS отключен. Восстановлены стандартные настройки DNS и hosts.${C_RESET}"
}

toggle_dns() {
    if is_active; then
        disable_dns
    else
        enable_dns
    fi
}

# ----------------- Status Helpers -----------------
is_active() {
    [ -f "$CONFIG_FILE" ] && return 0
    return 1
}

is_autostart_enabled() {
    [ "$(systemctl is-enabled "$SERVICE_NAME" 2>/dev/null)" = "enabled" ]
}

get_active_sni_in_hosts() {
    if grep -q "BEGIN DNS-AI-HOSTS" "$HOSTS_FILE" 2>/dev/null; then
        grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+.*generativelanguage' "$HOSTS_FILE" 2>/dev/null | awk '{print $1}' | head -n 1
    else
        echo ""
    fi
}

get_current_sni_mode_desc() {
    local mode="auto"
    if [ -f "$SNI_MODE_FILE" ]; then
        mode=$(cat "$SNI_MODE_FILE" 2>/dev/null | tr -d ' \n')
    elif [ -f "$CACHE_DIR/sni_mode" ]; then
        mode=$(cat "$CACHE_DIR/sni_mode" 2>/dev/null | tr -d ' \n')
    fi
    case "$mode" in
        geohide-eu)     echo "Принудительно GeoHide EU (Европа)" ;;
        geohide-us)     echo "Принудительно GeoHide US (США)" ;;
        primary)        echo "Принудительно DNS-AI Primary ($DNS_AI_SNI_PRIMARY)" ;;
        direct|bypass)  echo "Прямой доступ (Google Direct Anycast)" ;;
        none|disabled)  echo "Отключен" ;;
        manual:*)       echo "Ручной (${mode#manual:})" ;;
        auto|*)         echo "Автовыбор (быстрый живой узел с TLS)" ;;
    esac
}

# ----------------- Autostart Management -----------------
manage_autostart() {
    local action="$1"

    if [ ! -f "/etc/systemd/system/$SERVICE_NAME" ]; then
        cat << SERVICE > "/etc/systemd/system/$SERVICE_NAME"
[Unit]
Description=DNS-AI & GeoHide Encrypted DNS and AI Services Routing
Documentation=https://github.com/Falmer-128/dns-ai-tui
After=network-online.target systemd-resolved.service
Wants=network-online.target systemd-resolved.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/dns-ai on
ExecStop=/usr/local/bin/dns-ai off

[Install]
WantedBy=multi-user.target
SERVICE
        chmod 644 "/etc/systemd/system/$SERVICE_NAME"
        systemctl daemon-reload 2>/dev/null || true
    fi

    case "$action" in
        enable)
            systemctl enable "$SERVICE_NAME" 2>/dev/null
            echo -e "${C_GREEN}✓ Автозагрузка включена (systemd service enabled).${C_RESET}"
            ;;
        disable)
            systemctl disable "$SERVICE_NAME" 2>/dev/null
            echo -e "${C_YELLOW}✓ Автозагрузка отключена.${C_RESET}"
            ;;
        toggle)
            if is_autostart_enabled; then
                manage_autostart disable
            else
                manage_autostart enable
            fi
            ;;
    esac
}

# ----------------- Online IP Check & Diff Detection -----------------
check_for_ip_updates() {
    local interactive="${1:-false}"

    local py_out
    py_out=$(python3 -c "
import urllib.request, json, time, re, sys

cache_file = '$METADATA_FILE'
system_cache = '$STATE_DIR/metadata.json'

stored_data = {}
for p in [cache_file, system_cache]:
    try:
        with open(p, 'r') as f:
            stored_data = json.load(f)
            break
    except Exception:
        pass

update_found = False
change_details = []

# 1. Check DNS-AI
try:
    req = urllib.request.urlopen('https://dns-ai.ru/endpoints.json', timeout=2.5)
    current_dns_ai = json.loads(req.read().decode('utf-8'))
    new_serial = current_dns_ai.get('serial', 0)
    old_serial = stored_data.get('dns_ai_serial', 0)
    if new_serial > old_serial and old_serial > 0:
        update_found = True
        change_details.append(f'DNS-AI: Новая ревизия Serial {new_serial} (было: Serial {old_serial})')
        change_details.append(f'  Актуальные серверы: {\", \".join(current_dns_ai.get(\"v4\", []))}')
        if current_dns_ai.get('retired'):
            change_details.append(f'  Выведены из работы: {\", \".join(current_dns_ai.get(\"retired\", [])[-2:])}')
    stored_data['dns_ai_serial'] = new_serial
    stored_data['dns_ai_v4'] = current_dns_ai.get('v4', [])
except Exception:
    pass

# 2. Check GeoHide EU
try:
    req = urllib.request.Request('https://geohide.ru/eu/hosts', headers={'Range': 'bytes=0-300', 'User-Agent': 'curl/8.0'})
    res = urllib.request.urlopen(req, timeout=2.5).read().decode('utf-8', errors='ignore')
    m = re.search(r'Последнее обновление:\s*([^\r\n]+)', res)
    if m:
        new_date = m.group(1).strip()
        old_date = stored_data.get('geohide_eu_date', '')
        if old_date and new_date != old_date:
            update_found = True
            change_details.append(f'GeoHide: База обновлена от {new_date} (было: {old_date})')
        stored_data['geohide_eu_date'] = new_date
except Exception:
    pass

# Save updated metadata
try:
    with open(cache_file, 'w') as f:
        json.dump(stored_data, f, indent=2)
except Exception:
    pass

if update_found:
    print('UPDATE_AVAILABLE')
    for d in change_details:
        print(d)
    sys.exit(10)
else:
    print('UP_TO_DATE')
    sys.exit(0)
" 2>/dev/null)
    local ret=$?

    if [ $ret -eq 10 ]; then
        if [ "$interactive" = "true" ]; then
            clear
            echo -e "${C_CYAN}╔════════════════════════════════════════════════════════════════════╗${C_RESET}"
            echo -e "${C_CYAN}║               Обнаружено обновление серверов онлайн!               ║${C_RESET}"
