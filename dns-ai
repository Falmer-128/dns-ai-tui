def _real_hosts_path() -> str:
    path = str(HOSTS_FILE)
    try:
        if os.path.islink(path):
            resolved = os.path.realpath(path)
            if os.path.exists(resolved):
                return resolved
    except OSError:
        pass
    return path


def strip_hosts_block(text: str) -> Tuple[str, str, int]:
    lines = text.splitlines(keepends=True)
    begins = [i for i, l in enumerate(lines) if l.strip() == HOSTS_BEGIN]
    ends = [i for i, l in enumerate(lines) if l.strip() == HOSTS_END]
    if not begins and not ends:
        return text, "absent", 0
    if len(begins) != len(ends):
        return text, "incomplete", 0

    ranges: List[Tuple[int, int]] = []
    for b, e in zip(begins, ends):
        if b >= e:
            return text, "incomplete", 0
        ranges.append((b, e))

    remove = set()
    for b, e in ranges:
        remove.update(range(b, e + 1))
    kept = [line for idx, line in enumerate(lines) if idx not in remove]
    return "".join(kept), "removed", len(remove)


def build_hosts_block(google_ip: str, openai_ip: str) -> str:
    if not google_ip and not openai_ip:
        return ""
    rows = [
        HOSTS_BEGIN,
        "# Managed by DNS-AI & GeoHide Console (https://github.com/Falmer-128/dns-ai-tui)",
    ]
    if google_ip:
        rows.append(f"# Google AI & Antigravity ({google_ip})")
        rows.extend(f"{google_ip} {d}" for d in GOOGLE_AI_DOMAINS)
    if openai_ip:
        rows.append(f"# OpenAI & Claude ({openai_ip})")
        rows.extend(f"{openai_ip} {d}" for d in OPENAI_DOMAINS)
    rows.append(HOSTS_END)
    return "\n".join(rows) + "\n"


def update_hosts_entry(google_ip: str, openai_ip: str) -> bool:
    path = _real_hosts_path()
    try:
        text = read_text(Path(path))
    except FileNotFoundError:
        text = ""
    except OSError as exc:
        error(f"Не удалось прочитать {path}: {short_error(exc)}")
        return False

    new_text, status, _ = strip_hosts_block(text)
    if status == "incomplete":
        warn("В /etc/hosts найден поврежденный маркер DNS-AI. Файл сохранен без изменений.")
        return False

    if new_text and not new_text.endswith("\n"):
        new_text += "\n"
    if google_ip or openai_ip:
        new_text += build_hosts_block(google_ip, openai_ip)

    if new_text == text:
        return True
    try:
        atomic_write_text(Path(path), new_text, mode=0o644, force_inplace=is_mountpoint(path))
        return True
    except OSError as exc:
        error(f"Не удалось обновить {path}: {short_error(exc)}")
        return False


def hosts_block_text() -> Optional[str]:
    try:
        lines = read_text(HOSTS_FILE).splitlines()
    except OSError:
        return None
    begins = [i for i, l in enumerate(lines) if l.strip() == HOSTS_BEGIN]
    ends = [i for i, l in enumerate(lines) if l.strip() == HOSTS_END]
    if len(begins) != 1 or len(ends) != 1 or begins[0] >= ends[0]:
        return None
    return "\n".join(lines[begins[0]:ends[0] + 1])


def get_active_sni_in_hosts() -> str:
    block = hosts_block_text()
    if not block:
        return ""
    for line in block.splitlines():
        m = re.match(r"^\s*(\d{1,3}(?:\.\d{1,3}){3})\s+generativelanguage\.googleapis\.com\b", line)
        if m:
            return m.group(1)
    return ""

