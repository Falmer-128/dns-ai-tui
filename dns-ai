def download_bytes(url: str, timeout: float = 20) -> bytes:
    request = urllib.request.Request(url, headers={"User-Agent": f"dns-ai/{VERSION}"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.read(2 * 1024 * 1024)


def self_update() -> int:
    print(f"{C_CYAN}╔════════════════════════════════════════════════════════════════════╗{C_RESET}")
    print(f"{C_CYAN}║              Обновление программы DNS-AI из GitHub                 ║{C_RESET}")
    print(f"{C_CYAN}╚════════════════════════════════════════════════════════════════════╝{C_RESET}")
    print(f"Проверка обновлений в репозитории: {C_WHITE}https://github.com/Falmer-128/dns-ai-tui{C_RESET}\n")

    print(f"{C_CYAN}--> Загрузка актуальной версии dns-ai с GitHub...{C_RESET}")
    try:
        payload = download_bytes(SCRIPT_URL, timeout=20)
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        error(f"Не удалось скачать файл обновления: {short_error(exc)}")
        _pause()
        return 1

    try:
        text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        error(f"Загруженный файл не является UTF-8: {short_error(exc)}")
        _pause()
        return 1
    if not text.startswith("#!/usr/bin/env python3"):
        error("Загруженный файл не является Python-скриптом dns-ai. Обновление отменено.")
        _pause()
        return 1
    try:
        ast.parse(text)
    except (SyntaxError, ValueError) as exc:
        error(f"Загруженный скрипт повреждён (ast): {short_error(exc)}. Обновление отменено.")
        _pause()
        return 1

    target = Path(os.path.realpath(__file__))
    if not os.access(str(target.parent), os.W_OK):
        target = Path("/usr/local/bin/dns-ai")
    try:
        target.parent.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        error(f"Не удалось подготовить каталог {target.parent}: {short_error(exc)}")
        _pause()
        return 1

    temp_name = ""
    try:
        fd, temp_name = tempfile.mkstemp(
            prefix=".dns-ai-update-", suffix=".py", dir=str(target.parent)
        )
        with os.fdopen(fd, "wb") as fh:
            fh.write(payload)
            fh.flush()
            os.fsync(fh.fileno())
        py_compile.compile(temp_name, cfile=temp_name + "c", doraise=True)
        try:
            os.unlink(temp_name + "c")
        except OSError:
            pass
    except (OSError, py_compile.PyCompileError) as exc:
        error(f"Проверка загруженного скрипта не пройдена: {short_error(exc)}. Обновление отменено.")
        _cleanup_temp(temp_name)
        _pause()
        return 1

    old_stat = None
    try:
        old_stat = os.stat(target)
    except OSError:
        pass
    try:
        os.chmod(temp_name, 0o755)
        if old_stat is not None and os.geteuid() == 0:
            try:
                os.chown(temp_name, old_stat.st_uid, old_stat.st_gid)
            except OSError:
                pass
        print(f"{C_CYAN}--> Применение обновления...{C_RESET}")
        os.replace(temp_name, target)
        temp_name = ""
        fsync_dir(str(target.parent))
    except OSError as exc:
        error(f"Не удалось установить обновление: {short_error(exc)}")
        _cleanup_temp(temp_name)
        _pause()
        return 1

    # Keep the familiar dns-ai-tui alias when updating the installed copy.
    if target == Path("/usr/local/bin/dns-ai"):
        link = Path("/usr/local/bin/dns-ai-tui")
        try:
            if link.is_symlink() or not link.exists():
                link.unlink(missing_ok=True)
                link.symlink_to(target)
        except OSError:
            pass

    # Optionally refresh the systemd unit as well.
    try:
        service_payload = download_bytes(SERVICE_URL, timeout=10).decode("utf-8")
        if "[Unit]" in service_payload and "ExecStart=" in service_payload:
            atomic_write_text(SERVICE_PATH, service_payload, mode=0o644)
            run_cmd(["systemctl", "daemon-reload"], timeout=10)
    except Exception:
        # The unit file is optional; a failure here must not abort the update.
        pass

    print(f"\n{C_GREEN}✓ Программа успешно обновлена до актуальной версии из GitHub!{C_RESET}")
    if is_active():
        print(f"{C_CYAN}--> Переприменение обновленной конфигурации DNS-AI...{C_RESET}")
        enable_dns()

    _pause("Нажмите Enter для перезапуска интерфейса...")
    interactive = sys.stdin.isatty()
    restart_args = [str(target), "tui"] if interactive else [str(target), "status"]
    try:
        os.execv(str(target), restart_args)
    except OSError as exc:
        error(f"Не удалось перезапустить интерфейс: {short_error(exc)}")
        return 1
    return 0


def _cleanup_temp(name: str) -> None:
    if not name:
        return
    for candidate in (name, name + "c"):
        try:
            os.unlink(candidate)
        except OSError:
            pass


def _pause(message: str = "Нажмите Enter для возврата...") -> None:
    if not sys.stdin.isatty():
        return
    try:
        input(f"{C_CYAN}{message}{C_RESET}")
    except (EOFError, KeyboardInterrupt):
        pass

