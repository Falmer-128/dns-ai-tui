# ----------------- CLI Command Routing -----------------
case "$1" in
    on|enable|start)
        shift
        enable_dns "$@"
        ;;
    off|disable|stop)
        disable_dns
        ;;
    toggle)
        shift
        toggle_dns "$@"
        ;;
    update|refresh)
        echo "--> Обновление кэша эндпоинтов DNS-AI..."
        fetch_endpoints
        if is_active; then
            enable_dns
        else
            echo "✓ Кэш обновлен. Запустите 'dns-ai on' для активации."
        fi
        ;;
    upgrade|self-update|update-app)
        shift
        self_update "$@"
        ;;
    test)
        run_full_test
        ;;
    status)
        show_status
        ;;
    autostart)
        shift
        manage_autostart "${1:-status}"
        ;;
    set-sni)
        shift
        if [ -n "$1" ]; then
            echo "$1" > "$MODE_FILE"
            echo "SNI mode set to: $1"
            if is_active; then enable_dns; fi
        else
            echo "Использование: dns-ai set-sni <auto|backup|primary|none|<ip>>"
        fi
        ;;
    set-ip)
        shift
        if [ -z "$1" ]; then
            echo "Использование: dns-ai set-ip <ip1> [ip2]"
            exit 1
        fi
        enable_dns "$*"
        ;;
    reset)
        disable_dns
        manage_autostart disable 2>/dev/null || true
        rm -f "$MODE_FILE" "$CACHE_FILE" 2>/dev/null || true
        echo "✓ Сброс завершен."
        ;;
    -h|--help|help)
        show_help
        ;;
    tui|menu|"")
        main_tui
        ;;
    *)
        show_help
        exit 1
        ;;
esac
