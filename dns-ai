PRIVATE_NETS = (
    ipaddress.ip_network("127.0.0.0/8"),
    ipaddress.ip_network("10.0.0.0/8"),
    ipaddress.ip_network("192.168.0.0/16"),
    ipaddress.ip_network("172.16.0.0/12"),
    ipaddress.ip_network("169.254.0.0/16"),
)


def is_private_or_reserved(ip: str) -> bool:
    try:
        addr = ipaddress.ip_address(ip)
    except ValueError:
        return True
    if any(addr in net for net in PRIVATE_NETS if addr.version == net.version):
        return True
    return bool(
        addr.is_private or addr.is_loopback or addr.is_link_local
        or addr.is_multicast or addr.is_unspecified
    )


def is_public_sni_candidate(ip: str) -> bool:
    """Reject private ranges and Google's own directly reachable IPs."""
    try:
        addr = ipaddress.ip_address(ip)
    except ValueError:
        return False
    if addr.version != 4 or is_private_or_reserved(ip):
        return False
    return (int(addr) >> 24) not in (172, 142, 216)


def verify_sni_tls(ip: str, timeout: float = 2.5, host: str = GENERATIVE_HOST) -> bool:
    """Validate a TLS 443 handshake against the Google SNI hostname."""
    context = ssl.create_default_context()
    context.check_hostname = True
    context.verify_mode = ssl.CERT_REQUIRED
    try:
        with socket.create_connection((ip, 443), timeout=timeout) as raw:
            raw.settimeout(timeout)
            with context.wrap_socket(raw, server_hostname=host) as tls:
                tls.do_handshake()
        return True
    except (OSError, ssl.SSLError, ValueError):
        return False


def parse_query_ip(output: str, name: str) -> Optional[str]:
    """Parse both 'name: IP' and bare-IP resolvectl output formats."""
    v4: List[str] = []
    v6: List[str] = []
    prefix = name.lower() + ":"
    for raw_line in output.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("("):
            continue
        if line.lower().startswith(prefix):
            line = line[len(prefix):].strip()
        for token in re.split(r"[\s,;()\[\]]+", line):
            token = token.strip(".").split("%", 1)[0]
            if not token:
                continue
            try:
                addr = ipaddress.ip_address(token)
            except ValueError:
                continue
            if addr.version == 4:
                v4.append(str(addr))
            else:
                v6.append(str(addr))
    if v4:
        return v4[0]
    if v6:
        return v6[0]
    return None


def resolvectl_query_ip(name: str) -> Optional[str]:
    if not command_exists("resolvectl"):
        return None
    result = run_cmd(["resolvectl", "query", name], timeout=3, env=c_locale_env())
    return parse_query_ip(result.stdout, name)


def get_sni_mode() -> str:
    mode = str(load_state().get("sni_mode") or "auto").strip()
    return mode or "auto"


def set_sni_mode(mode: str) -> None:
    with state_lock():
        state = load_state()
        state["sni_mode"] = mode
        save_state(state)


def determine_sni_ip() -> str:
    """Resolve the effective Google AI SNI IP according to the saved mode."""
    mode = get_sni_mode()
    if mode.startswith("manual:"):
        return mode.split(":", 1)[1].strip()
    if mode in ("backup", "143") or mode.startswith("143"):
        return BACKUP_SNI_IP
    if mode in ("primary", "109") or mode.startswith("109"):
        return PRIMARY_SNI_IP
    if mode in ("none", "disabled"):
        return ""

    # auto: probe the stable backup first, then DNS, then primary.
    if verify_sni_tls(BACKUP_SNI_IP, 2.0):
        return BACKUP_SNI_IP
    candidate = resolvectl_query_ip(GENERATIVE_HOST)
    if candidate and candidate != BACKUP_SNI_IP and is_public_sni_candidate(candidate):
        if verify_sni_tls(candidate, 2.0):
            return candidate
    if verify_sni_tls(PRIMARY_SNI_IP, 1.5):
        return PRIMARY_SNI_IP
    return BACKUP_SNI_IP


def get_sni_mode_desc() -> str:
    mode = get_sni_mode()
    if mode.startswith("manual:"):
        return f"Ручной ({mode.split(':', 1)[1]})"
    if mode == "backup" or mode.startswith("143"):
        return f"Принудительно резерв ({BACKUP_SNI_IP})"
    if mode == "primary" or mode.startswith("109"):
        return f"Принудительно основной ({PRIMARY_SNI_IP})"
    if mode in ("none", "disabled"):
        return "Отключен"
    return "Автоматический выбор (с проверкой TLS)"

