# ----------------- Profile Helpers -----------------
get_active_profile() {
    local prof="geohide-eu"
    if [ -f "$PROFILE_FILE" ]; then
        prof=$(cat "$PROFILE_FILE" 2>/dev/null | tr -d ' \n')
    elif [ -f "$CACHE_DIR/profile" ]; then
        prof=$(cat "$CACHE_DIR/profile" 2>/dev/null | tr -d ' \n')
    fi
    case "$prof" in
        geohide-eu|geohide-us|geohide-ru|dns-ai)
            echo "$prof"
            ;;
        *)
            echo "geohide-eu"
            ;;
    esac
}

get_profile_name() {
    local prof="${1:-$(get_active_profile)}"
    case "$prof" in
        geohide-eu) echo "GeoHide EU (Европа — Рекомендуется)" ;;
        geohide-us) echo "GeoHide US (США)" ;;
        geohide-ru) echo "GeoHide RU (Россия)" ;;
        dns-ai)     echo "DNS-AI (Россия DoT + Швеция SNI)" ;;
        *)          echo "$prof" ;;
    esac
}

get_profile_tls_name() {
    local prof="${1:-$(get_active_profile)}"
    case "$prof" in
        geohide-eu) echo "$GEOHIDE_EU_TLS_NAME" ;;
        geohide-us) echo "$GEOHIDE_US_TLS_NAME" ;;
        geohide-ru) echo "$GEOHIDE_RU_TLS_NAME" ;;
        dns-ai)     echo "$DNS_AI_TLS_NAME" ;;
    esac
}

set_active_profile() {
    local prof="$1"
    mkdir -p "$STATE_DIR" "$CACHE_DIR" 2>/dev/null || true
    echo "$prof" > "$PROFILE_FILE" 2>/dev/null || echo "$prof" > "$CACHE_DIR/profile" 2>/dev/null || true
}

set_sni_mode() {
    local mode="$1"
    mkdir -p "$STATE_DIR" "$CACHE_DIR" 2>/dev/null || true
    echo "$mode" > "$SNI_MODE_FILE" 2>/dev/null || echo "$mode" > "$CACHE_DIR/sni_mode" 2>/dev/null || true
}

# ----------------- Network & Upstream Endpoints -----------------
fetch_dns_ai_endpoints() {
    local data=""
    data=$(curl -fsSL --max-time 4 https://dns-ai.ru/endpoints.json 2>/dev/null || \
           curl -fsSL --max-time 4 https://raw.githubusercontent.com/confeden/DNS-AI/main/endpoints.json 2>/dev/null || true)
    if [ -n "$data" ] && echo "$data" | grep -q '"v4"'; then
        mkdir -p "$CACHE_DIR" 2>/dev/null || true
        echo "$data" > "$DNS_AI_CACHE" 2>/dev/null || true
        echo "$data"
        return 0
    elif [ -f "$DNS_AI_CACHE" ]; then
        cat "$DNS_AI_CACHE"
        return 0
    fi
    return 1
}

get_profile_dns_servers() {
    local prof="${1:-$(get_active_profile)}"
    case "$prof" in
        dns-ai)
            local json="" v4="" v6=""
            json=$(fetch_dns_ai_endpoints 2>/dev/null || true)
            if [ -n "$json" ]; then
                v4=$(echo "$json" | sed -n 's/.*"v4":\[\([^]]*\)\].*/\1/p' | tr ',' '\n' | tr -d '" ' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -n 3 | tr '\n' ' ')
                v6=$(echo "$json" | sed -n 's/.*"v6":\[\([^]]*\)\].*/\1/p' | tr ',' '\n' | tr -d '" ' | grep ':' | head -n 2 | tr '\n' ' ')
            fi
            [ -z "$v4" ] && v4="$DNS_AI_DEFAULT_V4"
            [ -z "$v6" ] && v6="$DNS_AI_DEFAULT_V6"
            echo "$v4|$v6"
            ;;
        geohide-eu)
            echo "$GEOHIDE_EU_DEFAULT_V4|"
            ;;
        geohide-us)
            echo "$GEOHIDE_US_DEFAULT_V4|"
            ;;
        geohide-ru)
            echo "$GEOHIDE_RU_DEFAULT_V4|"
            ;;
    esac
}

# ----------------- TLS & SNI Validation -----------------
verify_sni_tls() {
    local host="$1"
    local ip="$2"
    local timeout="${3:-2.0}"
    python3 -c "
import ssl, socket, sys
try:
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout($timeout)
    s.connect(('$ip', 443))
    ss = ctx.wrap_socket(s, server_hostname='$host')
    ss.close()
    sys.exit(0)
except Exception:
    sys.exit(1)
" 2>/dev/null
}

find_best_sni_node() {
    local host="$1"
    shift
    local candidates=("$@")
    for ip in "${candidates[@]}"; do
        if verify_sni_tls "$host" "$ip" 1.8; then
            echo "$ip"
            return 0
        fi
    done
    return 1
}

determine_google_sni_ip() {
    local mode="auto"
    if [ -f "$SNI_MODE_FILE" ]; then
        mode=$(cat "$SNI_MODE_FILE" 2>/dev/null | tr -d ' \n')
    elif [ -f "$CACHE_DIR/sni_mode" ]; then
        mode=$(cat "$CACHE_DIR/sni_mode" 2>/dev/null | tr -d ' \n')
    fi

    case "$mode" in
        geohide-eu|eu*)
            find_best_sni_node "generativelanguage.googleapis.com" $GEOHIDE_EU_SNI_NODES || echo "143.20.64.192"
            return 0
            ;;
        geohide-us|us*)
            find_best_sni_node "generativelanguage.googleapis.com" $GEOHIDE_US_SNI_NODES || echo "192.255.159.240"
            return 0
            ;;
        primary|109*)
            echo "$DNS_AI_SNI_PRIMARY"
            return 0
            ;;
        direct|bypass)
            # Use Google Anycast IP directly
            echo "172.217.117.4"
            return 0
            ;;
        none|disabled)
            echo ""
            return 0
            ;;
        manual:*)
            echo "${mode#manual:}"
            return 0
            ;;
        auto|*)
            local prof
            prof=$(get_active_profile)
            if [ "$prof" = "geohide-us" ]; then
                find_best_sni_node "generativelanguage.googleapis.com" $GEOHIDE_US_SNI_NODES && return 0
            else
                # For geohide-eu, dns-ai and geohide-ru: GeoHide EU is the fastest and most reliable for Google AI
                find_best_sni_node "generativelanguage.googleapis.com" $GEOHIDE_EU_SNI_NODES && return 0
                find_best_sni_node "generativelanguage.googleapis.com" $GEOHIDE_US_SNI_NODES && return 0
            fi
            # If all SNI proxies fail, fall back to direct Google Anycast to prevent blackholing traffic
            if verify_sni_tls "generativelanguage.googleapis.com" "172.217.117.4" 1.5; then
                echo "172.217.117.4"
                return 0
            fi
            echo ""
            return 0
            ;;
    esac
}

determine_openai_sni_ip() {
    local prof
    prof=$(get_active_profile)
    case "$prof" in
        geohide-eu)
            find_best_sni_node "chatgpt.com" $GEOHIDE_EU_SNI_NODES || echo "143.20.64.192"
            ;;
        geohide-us)
            find_best_sni_node "chatgpt.com" $GEOHIDE_US_SNI_NODES || echo "192.255.159.240"
            ;;
        geohide-ru)
            find_best_sni_node "chatgpt.com" $GEOHIDE_RU_SNI_NODES || echo "193.233.112.67"
            ;;
        dns-ai|*)
            if verify_sni_tls "chatgpt.com" "$DNS_AI_SNI_OPENAI" 2.0; then
                echo "$DNS_AI_SNI_OPENAI"
            else
                find_best_sni_node "chatgpt.com" $GEOHIDE_EU_SNI_NODES || echo "$DNS_AI_SNI_OPENAI"
            fi
            ;;
    esac
}

