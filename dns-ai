NO_ROOT_COMMANDS = {"test", "status", "check-ip", "-h", "--help", "help"}
ROOT_COMMANDS = {
    "on", "enable", "start",
    "off", "disable", "stop",
    "toggle",
    "profile",
    "set-sni",
    "autostart",
    "update", "refresh",
    "upgrade", "self-update", "update-app",
    "reset",
    "reconcile",
    "tui", "menu", "",
}


def needs_root(cmd: str) -> bool:
    return cmd not in NO_ROOT_COMMANDS and cmd in ROOT_COMMANDS


def escalate() -> int:
    tool = shutil.which("sudo") or shutil.which("doas")
    if not tool or os.environ.get("DNS_AI_ESCALATED") == "1":
        print(f"{C_RED}Ошибка:{C_RESET} Для выполнения этого действия требуются права root (sudo).", file=sys.stderr)
        return 1

    script = os.path.abspath(sys.argv[0])
    args = sys.argv[1:]
    env_tool = shutil.which("env")
    prefix: List[str] = [tool]
    if env_tool:
        prefix.extend([env_tool, "DNS_AI_ESCALATED=1"])
    target = [script, *args] if os.access(script, os.X_OK) else [sys.executable, script, *args]

    try:
        os.execv(tool, prefix + target)
    except OSError as exc:
        print(f"{C_RED}Ошибка:{C_RESET} Не удалось повысить права: {short_error(exc)}", file=sys.stderr)
        return 1
    return 1


def main(argv: Sequence[str]) -> int:
    cmd = argv[0] if argv else ""
    args = list(argv[1:])

    clean_args = [a for a in args if not a.startswith("-")]
    is_quiet = any(a in ("--quiet", "-q", "--service", "-s") for a in args)

    if cmd in ("on", "enable", "start"):
        prof = clean_args[0] if clean_args else None
        return 0 if enable_dns(profile=prof, quiet=is_quiet) else 1
    if cmd in ("off", "disable", "stop"):
        return 0 if disable_dns(quiet=is_quiet) else 1
    if cmd == "toggle":
        return 0 if toggle_dns() else 1
    if cmd == "profile":
        if clean_args:
            set_active_profile(clean_args[0])
            if is_active():
                enable_dns()
            else:
                print(f"✓ Профиль переключен на {PROFILES.get(clean_args[0], {}).get('name', clean_args[0])}.")
            return 0
        print("Использование: dns-ai profile {geohide-eu|geohide-us|geohide-ru|dns-ai}")
        return 1
    if cmd == "set-sni":
        if clean_args:
            set_sni_mode(clean_args[0])
            if is_active():
                enable_dns()
            else:
                print(f"✓ Режим SNI установлен: {clean_args[0]}")
            return 0
        print("Использование: dns-ai set-sni {auto|geohide-eu|geohide-us|direct|primary|none|manual:<ip>}")
        return 1
    if cmd == "test":
        run_diagnostics(interactive=False)
        return 0
    if cmd == "status":
        show_status(interactive=False)
        return 0
    if cmd == "check-ip":
        print(f"{C_CYAN}--> Проверка актуальности серверов онлайн...{C_RESET}")
        if not check_for_ip_updates(interactive=True):
            print(f"{C_GREEN}✓ Все списки серверов актуальны. Обновление не требуется.{C_RESET}")
        return 0
    if cmd in ("update", "refresh"):
        print(f"{C_CYAN}--> Обновление базы адресов серверов...{C_RESET}")
        check_for_ip_updates(interactive=False)
        if is_active():
            enable_dns()
        else:
            print("✓ Кэш адресов обновлен.")
        return 0
    if cmd in ("upgrade", "self-update"):
        return self_update()
    if cmd == "autostart":
        action = clean_args[0] if clean_args else "status"
        return manage_autostart(action)
    if cmd == "reset":
        disable_dns()
        try:
            shutil.rmtree(STATE_DIR)
        except OSError:
            pass
        print("✓ Сброшено к заводским настройкам.")
        return 0
    if cmd == "reconcile":
        return cmd_reconcile()
    if cmd in ("-h", "--help", "help"):
        show_help()
        return 0
    if cmd in ("tui", "menu", ""):
        return main_tui()

    show_help()
    return 1


def entry() -> int:
    try:
        argv = list(sys.argv[1:])
        cmd = argv[0] if argv else ""
        if needs_root(cmd) and os.geteuid() != 0:
            return escalate()
        return main(argv)
    except KeyboardInterrupt:
        if sys.stdout.isatty():
            clear_screen()
        return 130
    except BrokenPipeError:
        return 0
    except Exception as exc:
        if os.environ.get("DNS_AI_DEBUG"):
            raise
        print(f"{C_RED}✗ Ошибка:{C_RESET} {short_error(exc)}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(entry())
