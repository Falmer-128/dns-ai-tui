# ----------------- Self-Update Engine -----------------
upgrade_self() {
    clear
    echo -e "${C_CYAN}╔════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║               Обновление программы из GitHub                       ║${C_RESET}"
    echo -e "${C_CYAN}╚════════════════════════════════════════════════════════════════════╝${C_RESET}"

    local tmp_dir
    tmp_dir=$(mktemp -d /tmp/dns-ai-update.XXXXXX)

    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    if [ -d "$script_dir/.git" ]; then
        echo -e "${C_CYAN}--> Обнаружен Git-репозиторий в $script_dir...${C_RESET}"
        git -C "$script_dir" pull origin main 2>&1 || git -C "$script_dir" pull 2>&1 || true
    fi

    echo -e "${C_CYAN}--> Загрузка актуальной версии dns-ai с GitHub...${C_RESET}"
    if ! curl -fsSL --max-time 15 "https://raw.githubusercontent.com/Falmer-128/dns-ai-tui/main/dns-ai" -o "$tmp_dir/dns-ai"; then
        echo -e "${C_RED}✗ Ошибка: Не удалось скачать файл обновления. Проверьте сеть.${C_RESET}"
        rm -rf "$tmp_dir"
        read -p "$(echo -e "${C_CYAN}Нажмите Enter для возврата...${C_RESET}")"
        return 1
    fi

    if ! bash -n "$tmp_dir/dns-ai" 2>/dev/null; then
        echo -e "${C_RED}✗ Ошибка: Загруженный скрипт содержит синтаксическую ошибку.${C_RESET}"
        rm -rf "$tmp_dir"
        read -p "$(echo -e "${C_CYAN}Нажмите Enter для возврата...${C_RESET}")"
        return 1
    fi

    curl -fsSL --max-time 10 "https://raw.githubusercontent.com/Falmer-128/dns-ai-tui/main/dns-ai.service" -o "$tmp_dir/dns-ai.service" 2>/dev/null || true

    echo -e "${C_CYAN}--> Применение новой версии...${C_RESET}"
    mkdir -p /usr/local/bin
    cp -f "$tmp_dir/dns-ai" /usr/local/bin/dns-ai
    chmod 755 /usr/local/bin/dns-ai
    ln -sf /usr/local/bin/dns-ai /usr/local/bin/dns-ai-tui

    if [ -s "$tmp_dir/dns-ai.service" ]; then
        cp -f "$tmp_dir/dns-ai.service" /etc/systemd/system/dns-ai.service
        chmod 644 /etc/systemd/system/dns-ai.service
        systemctl daemon-reload 2>/dev/null || true
    fi

    rm -rf "$tmp_dir"
    echo ""
    echo -e "${C_GREEN}✓ Программа успешно обновлена до актуальной версии из GitHub!${C_RESET}"

    if is_active; then
        echo -e "${C_CYAN}--> Переприменение конфигурации...${C_RESET}"
        enable_dns
    fi

    echo ""
    read -p "$(echo -e "${C_CYAN}Нажмите Enter для перезапуска интерфейса...${C_RESET}")"
    exec /usr/local/bin/dns-ai "$@"
}

