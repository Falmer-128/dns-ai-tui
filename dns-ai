                update_hosts_entry ""
                echo -e "${C_YELLOW}✓ Оверрайд Google AI отключен!${C_RESET}"
                sleep 1.5
                ;;
            0|"")
                break
                ;;
            *)
                echo -e "${C_RED}Неверный выбор!${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

