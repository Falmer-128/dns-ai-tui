def valid_ip(value: str) -> bool:
    try:
        ipaddress.ip_address(value)
        return True
    except ValueError:
        return False


def verify_sni_tls(ip: str, host: str, timeout: float = 2.0) -> bool:
    """Validate TLS 443 handshake with server_hostname."""
    context = ssl.create_default_context()
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    try:
        with socket.create_connection((ip, 443), timeout=timeout) as raw:
            raw.settimeout(timeout)
            with context.wrap_socket(raw, server_hostname=host) as tls:
                tls.do_handshake()
        return True
    except (OSError, ssl.SSLError, ValueError):
        return False


def find_best_sni_node(host: str, candidates: Sequence[str], timeout: float = 1.8) -> Optional[str]:
    for ip in candidates:
        if verify_sni_tls(ip, host, timeout=timeout):
            return ip
    return None


def determine_google_sni_ip() -> str:
    mode = get_sni_mode()
    prof = get_active_profile()

    if mode in ("geohide-eu", "eu"):
        node = find_best_sni_node("generativelanguage.googleapis.com", PROFILES["geohide-eu"]["sni_nodes"])
        return node or "143.20.64.192"
    if mode in ("geohide-us", "us"):
        node = find_best_sni_node("generativelanguage.googleapis.com", PROFILES["geohide-us"]["sni_nodes"])
        return node or "192.255.159.240"
    if mode in ("primary", "109"):
        return PROFILES["dns-ai"]["sni_primary"]
    if mode in ("direct", "bypass"):
        return "172.217.117.4"
    if mode in ("none", "disabled"):
        return ""
    if mode.startswith("manual:"):
        return mode.split(":", 1)[1].strip()

    # auto mode: prioritize EU nodes, then US, then Direct
    if prof == "geohide-us":
        node = find_best_sni_node("generativelanguage.googleapis.com", PROFILES["geohide-us"]["sni_nodes"])
        if node:
            return node
    else:
        node = find_best_sni_node("generativelanguage.googleapis.com", PROFILES["geohide-eu"]["sni_nodes"])
        if node:
            return node
        node = find_best_sni_node("generativelanguage.googleapis.com", PROFILES["geohide-us"]["sni_nodes"])
        if node:
            return node

    # Fallback to direct Google anycast if available to prevent blackhole
    if verify_sni_tls("172.217.117.4", "generativelanguage.googleapis.com", 1.5):
        return "172.217.117.4"

    return ""


def determine_openai_sni_ip() -> str:
    prof = get_active_profile()
    if prof == "geohide-eu":
        node = find_best_sni_node("chatgpt.com", PROFILES["geohide-eu"]["sni_nodes"])
        return node or "143.20.64.192"
    if prof == "geohide-us":
        node = find_best_sni_node("chatgpt.com", PROFILES["geohide-us"]["sni_nodes"])
        return node or "192.255.159.240"
    if prof == "geohide-ru":
        node = find_best_sni_node("chatgpt.com", PROFILES["geohide-ru"]["sni_nodes"])
        return node or "193.233.112.67"

    # dns-ai profile
    openai_ip = PROFILES["dns-ai"]["sni_openai"]
    if verify_sni_tls(openai_ip, "chatgpt.com", 2.0):
        return openai_ip
    node = find_best_sni_node("chatgpt.com", PROFILES["geohide-eu"]["sni_nodes"])
    return node or openai_ip

