def valid_ip(value: str) -> bool:
    try:
        ipaddress.ip_address(value)
        return True
    except ValueError:
        return False


def valid_ipv4(value: str) -> bool:
    try:
        return ipaddress.ip_address(value).version == 4
    except ValueError:
        return False


def normalize_endpoints(data: Any) -> Optional[Dict[str, Any]]:
    if not isinstance(data, dict):
        return None
    v4 = [str(item) for item in data.get("v4", []) if valid_ipv4(str(item))] if isinstance(data.get("v4"), list) else []
    v6 = [str(item) for item in data.get("v6", []) if valid_ip(str(item)) and ":" in str(item)] if isinstance(data.get("v6"), list) else []
    retired = [str(item) for item in data.get("retired", []) if valid_ipv4(str(item))] if isinstance(data.get("retired"), list) else []
    if not v4:
        return None
    return {
        "v4": v4[:8],
        "v6": v6[:8],
        "retired": retired[:20],
        "serial": data.get("serial"),
    }


def download_endpoints(timeout: float = 5) -> Optional[Dict[str, Any]]:
    """Download endpoints.json from the official mirrors (no caching)."""
    for url in ENDPOINT_URLS:
        request = urllib.request.Request(url, headers={"User-Agent": f"dns-ai/{VERSION}"})
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                raw = response.read(1024 * 1024)
            normalized = normalize_endpoints(json.loads(raw.decode("utf-8")))
            if normalized:
                return normalized
        except (urllib.error.URLError, TimeoutError, ValueError, OSError):
            continue
    return None


def cache_endpoints(data: Dict[str, Any]) -> None:
    with state_lock():
        state = load_state()
        state["endpoints"] = data
        state["endpoints_updated"] = int(time.time())
        save_state(state)


def get_endpoints() -> Dict[str, Any]:
    """Fetch fresh endpoints, else use the cache, else built-in defaults."""
    data = download_endpoints()
    if data:
        try:
            cache_endpoints(data)
        except OSError:
            pass
        return data
    cached = normalize_endpoints(load_state().get("endpoints"))
    if cached:
        return cached
    return {
        "v4": list(DEFAULT_V4),
        "v6": list(DEFAULT_V6),
        "retired": [],
        "serial": None,
    }


def has_global_v6() -> bool:
    if not command_exists("ip"):
        return False
    result = run_cmd(["ip", "-6", "route", "show", "default"], timeout=3)
    return result.returncode == 0 and "default" in result.stdout

# ------------------------------------------------------------------------------
# Safe /etc/hosts management
# ------------------------------------------------------------------------------

def _real_hosts_path() -> str:
    """Resolve a symlinked /etc/hosts, tolerating unusual container setups."""
    path = str(HOSTS_FILE)
    try:
        if os.path.islink(path):
            resolved = os.path.realpath(path)
            if os.path.exists(resolved):
                return resolved
    except OSError:
        pass
    return path


def strip_hosts_block(text: str) -> Tuple[str, str, int]:
    """Remove DNS-AI blocks only when every BEGIN has a matching END.

    Returns (new_text, status, removed_lines).  status is one of:
    absent, removed, incomplete.  On "incomplete" the text is untouched.
    """
    lines = text.splitlines(keepends=True)
    begins = [i for i, line in enumerate(lines) if line.strip() == HOSTS_BEGIN]
    ends = [i for i, line in enumerate(lines) if line.strip() == HOSTS_END]
    if not begins and not ends:
        return text, "absent", 0
    if len(begins) != len(ends):
        return text, "incomplete", 0

    ranges: List[Tuple[int, int]] = []
    for begin, end in zip(begins, ends):
        if begin >= end:
            return text, "incomplete", 0
        ranges.append((begin, end))

    remove = set()
    for begin, end in ranges:
        remove.update(range(begin, end + 1))
    kept = [line for index, line in enumerate(lines) if index not in remove]
    return "".join(kept), "removed", len(remove)


def build_hosts_block(ip: str) -> str:
    if not ip:
        return ""
    rows = [HOSTS_BEGIN]
    rows.extend(f"{ip} {domain}" for domain in AI_DOMAINS)
    rows.append(HOSTS_END)
    return "\n".join(rows) + "\n"


def update_hosts_entry(ip: str) -> bool:
    """Replace the DNS-AI block, preserving all unrelated hosts content."""
    path = _real_hosts_path()
    try:
        text = read_text(Path(path))
    except FileNotFoundError:
        text = ""
    except OSError as exc:
        error(f"Не удалось прочитать {path}: {short_error(exc)}")
        return False

    new_text, status, _ = strip_hosts_block(text)
    if status == "incomplete":
        warn("В /etc/hosts найден только один маркер DNS-AI. Файл не изменён.")
        return False

    if new_text and not new_text.endswith("\n"):
        new_text += "\n"
    if ip:
        new_text += build_hosts_block(ip)

    if new_text == text:
        return True
    try:
        atomic_write_text(Path(path), new_text, mode=0o644, force_inplace=is_mountpoint(path))
        return True
    except OSError as exc:
        error(f"Не удалось обновить {path}: {short_error(exc)}")
        return False


def hosts_block_text() -> Optional[str]:
    """Return the current DNS-AI block including markers, if complete."""
    try:
        lines = read_text(HOSTS_FILE).splitlines()
    except OSError:
        return None
    begins = [i for i, line in enumerate(lines) if line.strip() == HOSTS_BEGIN]
    ends = [i for i, line in enumerate(lines) if line.strip() == HOSTS_END]
    if len(begins) != 1 or len(ends) != 1 or begins[0] >= ends[0]:
        return None
    return "\n".join(lines[begins[0]:ends[0] + 1])


def get_active_sni_in_hosts() -> str:
    block = hosts_block_text()
    if not block:
        return ""
    for line in block.splitlines():
        match = re.match(r"^\s*(\d{1,3}(?:\.\d{1,3}){3})\s+generativelanguage\.googleapis\.com\b", line)
        if match:
            return match.group(1)
    return ""

# ------------------------------------------------------------------------------
# systemd-resolved and NetworkManager
# ------------------------------------------------------------------------------

def is_resolved_active() -> bool:
    if not command_exists("systemctl"):
        return False
    return run_cmd(["systemctl", "is-active", "--quiet", "systemd-resolved"], timeout=5).returncode == 0


def ensure_resolved_active() -> bool:
    if is_resolved_active():
        return True
    if not command_exists("systemctl"):
        return False
    run_cmd(["systemctl", "enable", "--now", "systemd-resolved"], timeout=20)
    return is_resolved_active()


def fix_resolv_conf() -> None:
    """Point /etc/resolv.conf at the systemd-resolved stub when possible."""
    stub = "/run/systemd/resolve/stub-resolv.conf"
    if not os.path.exists(stub):
        return
    try:
        if os.path.islink("/etc/resolv.conf") and os.readlink("/etc/resolv.conf") == stub:
            return
        if os.path.exists("/etc/resolv.conf") and not os.path.islink("/etc/resolv.conf"):
            run_cmd(["cp", "-p", "/etc/resolv.conf", "/etc/resolv.conf.dns-ai.bak"], timeout=5)
        try:
            os.unlink("/etc/resolv.conf")
        except FileNotFoundError:
            pass
        os.symlink(stub, "/etc/resolv.conf")
    except OSError:
        # Bind-mounted resolv.conf (containers) cannot be relinked.
        pass


def write_resolved_conf(v4: Sequence[str], v6: Sequence[str]) -> bool:
    entries = [f"{ip}#{TLS_NAME}" for ip in v4 if ip]
    entries.extend(f"{ip}#{TLS_NAME}" for ip in v6 if ip)
    if not entries:
        error("Нет DNS-серверов для настройки systemd-resolved.")
        return False
    content = (
        "# DNS-AI — systemd-resolved configuration\n"
        "[Resolve]\n"
        f"DNS={' '.join(entries)}\n"
        "DNSOverTLS=yes\n"
        "Domains=~.\n"
        "FallbackDNS=\n"
    )
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        atomic_write_text(CONFIG_FILE, content, mode=0o644)
        return True
    except OSError as exc:
        error(f"Не удалось записать {CONFIG_FILE}: {short_error(exc)}")
        return False


def restart_resolved() -> None:
    if command_exists("systemctl"):
        run_cmd(["systemctl", "restart", "systemd-resolved"], timeout=20)
    if command_exists("resolvectl"):
        run_cmd(["resolvectl", "flush-caches"], timeout=10)


def _nm_active() -> bool:
    if not command_exists("nmcli"):
        return False
    if not command_exists("systemctl"):
        return True
    return run_cmd(["systemctl", "is-active", "--quiet", "NetworkManager"], timeout=5).returncode == 0


def nm_apply_ignore_dns(state: Dict[str, Any]) -> None:
    """Stop NetworkManager from injecting DHCP DNS into per-link resolvers."""
    if not _nm_active():
        return
    result = run_cmd(
        ["nmcli", "-t", "-f", "UUID,TYPE,DEVICE", "connection", "show", "--active"],
        timeout=10,
    )
    if result.returncode != 0:
        return
    known = set(state.get("nm_connections", []))
    for line in result.stdout.splitlines():
        parts = line.split(":")
        if len(parts) < 2:
            continue
        uuid, conn_type = parts[0], parts[1].lower()
        device = parts[2] if len(parts) > 2 else ""
        if not uuid or conn_type in ("", "loopback", "bridge", "tun", "wireguard", "vpn", "dummy") or "docker" in conn_type:
            continue
        changed = run_cmd(
            ["nmcli", "connection", "modify", uuid,
             "ipv4.ignore-auto-dns", "yes", "ipv6.ignore-auto-dns", "yes"],
            timeout=10,
        )
        if changed.returncode != 0:
            continue
        known.add(uuid)
        if device:
            run_cmd(["nmcli", "device", "reapply", device], timeout=15)
    state["nm_connections"] = sorted(known)


def nm_restore_dns(uuids: Iterable[str]) -> None:
    if not command_exists("nmcli"):
        return
    for uuid in uuids:
        if not uuid:
            continue
        run_cmd(
            ["nmcli", "connection", "modify", uuid,
             "ipv4.ignore-auto-dns", "no", "ipv6.ignore-auto-dns", "no"],
            timeout=10,
        )
        device = run_cmd(
            ["nmcli", "-g", "GENERAL.DEVICES", "connection", "show", uuid], timeout=5
        ).stdout.strip()
        if device:
            run_cmd(["nmcli", "device", "reapply", device], timeout=15)

