def reset_all(final_message: str) -> int:
    disable_dns()
    manage_autostart("disable")
    for legacy in (LEGACY_MODE_FILE, LEGACY_CACHE_FILE, LEGACY_NM_FILE):
        try:
            legacy.unlink()
        except OSError:
            pass
    with state_lock():
        save_state(default_state())
    print(f"{C_GREEN}{final_message}{C_RESET}")
    return 0


def _validate_ips(values: Sequence[str]) -> Optional[List[str]]:
    cleaned: List[str] = []
    for value in values:
        try:
            cleaned.append(str(ipaddress.ip_address(value)))
        except ValueError:
            error(f"Некорректный IP-адрес: {value}")
            return None
    return cleaned


def _normalize_sni(value: str) -> Optional[str]:
    value = value.strip()
    if value in ("auto", "backup", "primary", "none", "disabled"):
        return value
    if value.startswith("manual:"):
        candidate = value.split(":", 1)[1].strip()
        return f"manual:{candidate}" if valid_ip(candidate) else None
    if valid_ip(value):
        return f"manual:{value}"
    return None


def cmd_on(args: Sequence[str]) -> int:
    clean_args = [arg for arg in args if not arg.startswith("-")]
    is_quiet = any(arg in ("--quiet", "-q", "--service", "-s") for arg in args)
    if clean_args:
        ips = _validate_ips(clean_args)
        if ips is None:
            return 1
        return 0 if enable_dns(custom_ips=ips, quiet=is_quiet) else 1
    return 0 if enable_dns(quiet=is_quiet) else 1


def cmd_set_ip(args: Sequence[str]) -> int:
    if not args:
        print("Использование: dns-ai set-ip <ip1> [ip2]")
        return 1
    ips = _validate_ips(args)
    if ips is None:
        return 1
    return 0 if enable_dns(custom_ips=ips) else 1


def cmd_set_sni(args: Sequence[str]) -> int:
    if not args:
        print("Использование: dns-ai set-sni <auto|backup|primary|none|<ip>>")
        return 1
    mode = _normalize_sni(args[0])
    if mode is None:
        error(f"Некорректный режим SNI: {args[0]}")
        return 1
    set_sni_mode(mode)
    print(f"SNI mode set to: {mode}")
    if mode in ("none", "disabled"):
        update_hosts_entry("")
    if is_active():
        return 0 if enable_dns() else 1
    return 0


