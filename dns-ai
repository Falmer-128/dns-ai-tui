def set_quiet(value: bool) -> None:
    """Enable or disable all normal command output."""
    global QUIET
    QUIET = bool(value)


def say(message: str = "") -> None:
    if not QUIET:
        print(message)


def warn(message: str) -> None:
    if not QUIET:
        print(f"{C_YELLOW}{message}{C_RESET}")


def error(message: str) -> None:
    if not QUIET:
        print(f"{C_RED}✗ Ошибка:{C_RESET} {message}", file=sys.stderr)


def clear_screen() -> None:
    sys.stdout.write("\033[2J\033[H")
    sys.stdout.flush()


def command_exists(name: str) -> bool:
    return shutil.which(name) is not None


def c_locale_env() -> Dict[str, str]:
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    env["LANG"] = "C"
    return env


def run_cmd(
    args: Sequence[str],
    timeout: float = 10,
    env: Optional[Dict[str, str]] = None,
) -> subprocess.CompletedProcess:
    """Run a command without ever raising for common failures."""
    try:
        return subprocess.run(
            list(args),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            errors="replace",
            timeout=timeout,
            env=env,
        )
    except FileNotFoundError:
        return subprocess.CompletedProcess(list(args), 127, "", f"not found: {args[0]}")
    except subprocess.TimeoutExpired as exc:
        return subprocess.CompletedProcess(list(args), 124, "", f"timeout: {exc}")
    except OSError as exc:
        return subprocess.CompletedProcess(list(args), 1, "", str(exc))


def short_error(exc: BaseException) -> str:
    text = str(exc) or exc.__class__.__name__
    return text if len(text) <= 100 else text[:97] + "..."


# ------------------------------------------------------------------------------
# Filesystem helpers: fsync, bind mounts, atomic replacement
# ------------------------------------------------------------------------------

def fsync_dir(directory: str) -> None:
    try:
        fd = os.open(directory, os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    except OSError:
        pass


def _unescape_mountinfo(value: str) -> str:
    for old, new in (("\\040", " "), ("\\011", "\t"), ("\\012", "\n"), ("\\134", "\\")):
        value = value.replace(old, new)
    return value


def is_mountpoint(path: str) -> bool:
    """Return True when *path* is a mount point (including a bind mount)."""
    target = os.path.realpath(path)
    try:
        with open("/proc/self/mountinfo", "r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                fields = line.split()
                if len(fields) > 4 and os.path.realpath(_unescape_mountinfo(fields[4])) == target:
                    return True
    except OSError:
        pass
    try:
        return os.path.ismount(target)
    except OSError:
        return False


def atomic_write_text(
    path: Path,
    text: str,
    mode: Optional[int] = None,
    force_inplace: bool = False,
) -> None:
    """Atomically write *text*, preserving owner when running as root.

    Bind mounts cannot be atomically replaced without detaching them, so they
    are rewritten in place.  Symlinks are expected to be resolved by callers.
    """
    filename = os.path.abspath(str(path))
    directory = os.path.dirname(filename) or "."
    os.makedirs(directory, exist_ok=True)

    old_stat = None
    try:
        old_stat = os.stat(filename)
    except OSError:
        pass
    if mode is None:
        mode = stat.S_IMODE(old_stat.st_mode) if old_stat else 0o644

    if force_inplace or is_mountpoint(filename):
        with open(filename, "w", encoding="utf-8", errors="surrogateescape", newline="") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        return

    fd, tmp = tempfile.mkstemp(
        prefix=f".{os.path.basename(filename)}.", suffix=".tmp", dir=directory
    )
    try:
        with os.fdopen(fd, "w", encoding="utf-8", errors="surrogateescape", newline="") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        if old_stat is not None and os.geteuid() == 0:
            try:
                os.chown(tmp, old_stat.st_uid, old_stat.st_gid)
            except OSError:
                pass
        os.replace(tmp, filename)
        fsync_dir(directory)
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def read_text(path: Path) -> str:
    with open(path, "r", encoding="utf-8", errors="surrogateescape") as fh:
        return fh.read()

# ------------------------------------------------------------------------------
# State machine and flock based locking
# ------------------------------------------------------------------------------

def default_state() -> Dict[str, Any]:
    return {
        "version": 1,
        "enabled": False,
        "sni_mode": "auto",
        "last_sni": "",
        "dns_v4": [],
        "dns_v6": [],
        "nm_connections": [],
        "endpoints": {},
        "endpoints_updated": 0,
        "updated_at": 0,
    }


def _legacy_state() -> Dict[str, Any]:
    """Read the old /etc/dns-ai files once, for seamless upgrades."""
    state = default_state()
    try:
        mode = read_text(LEGACY_MODE_FILE).strip()
        if mode:
            state["sni_mode"] = mode
    except OSError:
        pass
    try:
        cached = json.loads(read_text(LEGACY_CACHE_FILE))
        normalized = normalize_endpoints(cached)
        if normalized:
            state["endpoints"] = normalized
    except (OSError, ValueError):
        pass
    try:
        uuids = [line.strip() for line in read_text(LEGACY_NM_FILE).splitlines() if line.strip()]
        state["nm_connections"] = uuids
    except OSError:
        pass
    return state


def load_state() -> Dict[str, Any]:
    """Load state.json, falling back to legacy files and sane defaults."""
    try:
        data = json.loads(read_text(STATE_FILE))
    except FileNotFoundError:
        return _legacy_state()
    except (OSError, ValueError):
        return default_state()
    if not isinstance(data, dict):
        return default_state()

    state = default_state()
    state.update(data)
    if not isinstance(state.get("sni_mode"), str):
        state["sni_mode"] = "auto"
    for key in ("dns_v4", "dns_v6", "nm_connections"):
        value = state.get(key)
        state[key] = [str(item) for item in value] if isinstance(value, list) else []
    if not isinstance(state.get("endpoints"), dict):
        state["endpoints"] = {}
    return state


def save_state(state: Dict[str, Any]) -> None:
    """Persist state atomically with fsync on both file and directory."""
    state["updated_at"] = int(time.time())
    os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
    payload = json.dumps(state, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    atomic_write_text(STATE_FILE, payload, mode=0o644)


@contextlib.contextmanager
def state_lock():
    """Exclusive re-entrant lock backed by fcntl.flock()."""
    global _LOCK_FD, _LOCK_DEPTH
    if _LOCK_DEPTH > 0:
        _LOCK_DEPTH += 1
        try:
            yield
        finally:
            _LOCK_DEPTH -= 1
        return

    os.makedirs(RUN_DIR, mode=0o755, exist_ok=True)
    fd = os.open(str(LOCK_FILE), os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
    except OSError:
        os.close(fd)
        raise
    _LOCK_FD = fd
    _LOCK_DEPTH = 1
    try:
        yield
    finally:
        _LOCK_DEPTH = 0
        _LOCK_FD = None
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        os.close(fd)


def active_config_path() -> Optional[Path]:
