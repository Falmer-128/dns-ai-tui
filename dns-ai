def is_autostart_enabled() -> bool:
    if not command_exists("systemctl"):
        return False
    return run_cmd(["systemctl", "is-enabled", SERVICE_NAME], timeout=5).stdout.strip() == "enabled"


def ensure_service_file() -> None:
    if SERVICE_PATH.is_file():
        return
    content = f"""[Unit]
Description=DNS-AI & GeoHide Encrypted DNS and AI Services Routing
Documentation=https://github.com/Falmer-128/dns-ai-tui
After=network-online.target time-sync.target systemd-resolved.service NetworkManager-wait-online.service
Wants=network-online.target time-sync.target systemd-resolved.service
ConditionPathExists=/usr/local/bin/dns-ai

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/dns-ai on --service
ExecStop=/usr/local/bin/dns-ai off --service
ExecReload=/usr/local/bin/dns-ai reconcile --quiet
TimeoutStartSec=30
SyslogIdentifier=dns-ai

[Install]
WantedBy=multi-user.target
"""
    try:
        SERVICE_PATH.parent.mkdir(parents=True, exist_ok=True)
        atomic_write_text(SERVICE_PATH, content, mode=0o644)
        run_cmd(["systemctl", "daemon-reload"], timeout=10)
    except OSError as exc:
        error(f"Не удалось создать {SERVICE_PATH}: {short_error(exc)}")


def manage_autostart(action: str = "status") -> int:
    action = (action or "status").lower()
    if action == "toggle":
        action = "disable" if is_autostart_enabled() else "enable"

    if action in ("enable", "disable"):
        ensure_service_file()
        res = run_cmd(["systemctl", action, SERVICE_NAME], timeout=15)
        run_cmd(["systemctl", "daemon-reload"], timeout=10)
        if res.returncode != 0:
            error(f"systemctl {action} {SERVICE_NAME}: {short_error(res.stderr or res.stdout)}")
            return 1
        if action == "enable":
            print(f"{C_GREEN}✓ Автозагрузка включена (systemd service enabled).{C_RESET}")
        else:
            print(f"{C_YELLOW}✓ Автозагрузка отключена.{C_RESET}")
        return 0

    if is_autostart_enabled():
        print(f"Автозагрузка: {C_GREEN}ВКЛЮЧЕНА (systemd enabled){C_RESET}")
    else:
        print(f"Автозагрузка: {C_YELLOW}ОТКЛЮЧЕНА (systemd disabled){C_RESET}")
    return 0

