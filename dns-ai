        fi

        if is_autostart_enabled; then
            echo -e "  Автозагрузка:     ${C_GREEN}● ВКЛЮЧЕНА (systemd service enabled)${C_RESET}"
        else
            echo -e "  Автозагрузка:     ${C_YELLOW}○ ОТКЛЮЧЕНА${C_RESET}"
        fi

        local active_sni
        active_sni=$(get_active_sni_in_hosts)
        if [ -n "$active_sni" ]; then
            echo -e "  Google AI SNI:    ${C_WHITE}$active_sni${C_RESET} \033[0;90m($(get_current_sni_mode_desc))\033[0m"
        else
            echo -e "  Google AI SNI:    ${C_YELLOW}без оверрайда${C_RESET} \033[0;90m($(get_current_sni_mode_desc))\033[0m"
        fi

        echo -e "  Защита от утечек: ${C_GRAY}NetworkManager DHCP DNS изолирован, Fallback=1.1.1.1${C_RESET}"
        echo ""
        echo -e "  ${C_BLUE}0)${C_RESET} ${C_BOLD}Выйти${C_RESET}"
        echo -e "  ${C_GREEN}1)${C_RESET} $( is_active && echo -e "${C_RED}Выключить шифрованный DNS${C_RESET}" || echo -e "${C_GREEN}Включить шифрованный DNS${C_RESET}" )"
        echo -e "  ${C_CYAN}2)${C_RESET} Сменить профиль (GeoHide EU / US / RU | DNS-AI)"
        echo -e "  ${C_GREEN}3)${C_RESET} Полный тест доступности (DoT, SNI, AI сервисы)"
        echo -e "  ${C_YELLOW}4)${C_RESET} Настройка Google AI / Antigravity SNI узла"
        echo -e "  ${C_MAGENTA}5)${C_RESET} Управление автозагрузкой (Systemd)"
        echo -e "  ${C_CYAN}6)${C_RESET} Проверить и применить обновление IP серверов (Check & Sync)"
        echo -e "  ${C_WHITE}7)${C_RESET} Обновить программу из GitHub (Self-update)"
        echo -e "  ${C_GRAY}8)${C_RESET} Подробная системная сводка (resolvectl status)"
        echo -e "  ${C_RED}9)${C_RESET} Сбросить все настройки сети до стандартных"
        echo ""
        echo -e "  \033[0;90mРепозиторий проекта: https://github.com/Falmer-128/dns-ai-tui\033[0m"
        echo ""

        read -p "$(echo -e "${C_CYAN}Выберите действие [0-9]: ${C_RESET}")" CHOICE
        case "$CHOICE" in
            1)
                toggle_dns
                sleep 1.2
                ;;
            2)
                menu_select_profile
                ;;
            3)
                run_diagnostics "true"
                ;;
            4)
                menu_sni_settings
                ;;
            5)
                menu_autostart
                ;;
            6)
                clear
                echo -e "${C_CYAN}--> Проверка актуальности серверов онлайн...${C_RESET}"
                if check_for_ip_updates "true"; then
                    :
                else
                    echo -e "${C_GREEN}✓ Все списки серверов актуальны. Обновление не требуется.${C_RESET}"
                    sleep 1.5
                fi
                ;;
            7)
                upgrade_self
                ;;
            8)
                show_status "true"
                ;;
            9)
                disable_dns
                rm -rf "$CACHE_DIR"
                echo -e "${C_YELLOW}✓ Все настройки и кэш сброшены.${C_RESET}"
                sleep 1.5
                ;;
            0|q|Q)
                clear
                exit 0
                ;;
            *)
                echo -e "${C_RED}Неверный пункт меню!${C_RESET}"
                sleep 0.8
                ;;
        esac
    done
}

# ----------------- CLI Argument Router -----------------
case "$1" in
    on|enable|start)
        enable_dns "$2"
        ;;
    off|disable|stop)
        disable_dns
        ;;
    toggle)
        toggle_dns
        ;;
    profile)
        if [ -n "$2" ]; then
            set_active_profile "$2"
            if is_active; then enable_dns; else echo "✓ Профиль переключен на $(get_profile_name "$2")."; fi
        else
            echo "Использование: dns-ai profile {geohide-eu|geohide-us|geohide-ru|dns-ai}"
        fi
        ;;
    set-sni)
        if [ -n "$2" ]; then
            set_sni_mode "$2"
            if is_active; then enable_dns; else echo "✓ Режим SNI установлен: $2"; fi
        else
            echo "Использование: dns-ai set-sni {auto|geohide-eu|geohide-us|direct|primary|none|manual:<ip>}"
        fi
        ;;
    test)
        run_diagnostics "false"
        ;;
    status)
        show_status "false"
        ;;
    check-ip)
        echo -e "${C_CYAN}--> Проверка актуальности серверов онлайн...${C_RESET}"
        if check_for_ip_updates "true"; then
            :
        else
            echo -e "${C_GREEN}✓ Все списки серверов актуальны. Обновление не требуется.${C_RESET}"
        fi
        ;;
    update|refresh)
        echo -e "${C_CYAN}--> Обновление базы адресов серверов...${C_RESET}"
        fetch_dns_ai_endpoints >/dev/null 2>&1 || true
        if is_active; then enable_dns; else echo "✓ Кэш адресов обновлен."; fi
        ;;
    upgrade)
        upgrade_self
        ;;
    autostart)
        manage_autostart "${2:-toggle}"
        ;;
    reset)
        disable_dns
        rm -rf "$CACHE_DIR"
        echo "✓ Сброшено к заводским настройкам."
        ;;
    -h|--help|help)
        echo "Использование: dns-ai [КОМАНДА]"
        echo ""
        echo "Команды CLI:"
        echo "  dns-ai                           Запуск интерактивного меню (TUI)"
        echo "  dns-ai on [профиль]             Включить шифрованный DNS (geohide-eu|geohide-us|geohide-ru|dns-ai)"
        echo "  dns-ai off                       Выключить и вернуть стандартный DNS"
        echo "  dns-ai toggle                    Переключить состояние (On/Off)"
        echo "  dns-ai profile <имя>             Сменить активный профиль"
        echo "  dns-ai test                      Запустить полную диагностику DoT и SNI"
        echo "  dns-ai status                    Показать подробное состояние сети"
        echo "  dns-ai check-ip                  Проверить обновление IP серверов онлайн"
        echo "  dns-ai set-sni <режим>           Настроить SNI (auto|geohide-eu|geohide-us|direct|primary)"
        echo "  dns-ai autostart {enable|disable} Управление автозагрузкой systemd"
        echo "  dns-ai upgrade                   Обновить программу из GitHub"
        echo "  dns-ai reset                     Сбросить все настройки к стандартным"
        echo ""
        ;;
    *)
        main_tui "$@"
        ;;
esac
