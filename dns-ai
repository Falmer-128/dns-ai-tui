def run_cmd(
    args: Sequence[str],
    timeout: float = 10,
    env: Optional[Dict[str, str]] = None,
) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(
            list(args),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            errors="replace",
            timeout=timeout,
            env=env,
        )
    except FileNotFoundError:
        return subprocess.CompletedProcess(list(args), 127, "", f"not found: {args[0]}")
    except subprocess.TimeoutExpired as exc:
        return subprocess.CompletedProcess(list(args), 124, "", f"timeout: {exc}")
    except OSError as exc:
        return subprocess.CompletedProcess(list(args), 1, "", str(exc))


def short_error(exc: BaseException) -> str:
    text = str(exc) or exc.__class__.__name__
    return text if len(text) <= 100 else text[:97] + "..."

# ------------------------------------------------------------------------------
# Atomic Filesystem & Lock Management
# ------------------------------------------------------------------------------

def fsync_dir(directory: str) -> None:
    try:
        fd = os.open(directory, os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    except OSError:
        pass


def is_mountpoint(path: str) -> bool:
    target = os.path.realpath(path)
    try:
        with open("/proc/self/mountinfo", "r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                fields = line.split()
                if len(fields) > 4:
                    raw_mount = fields[4].replace("\\040", " ")
                    if os.path.realpath(raw_mount) == target:
                        return True
    except OSError:
        pass
    try:
        return os.path.ismount(target)
    except OSError:
        return False


def atomic_write_text(
    path: Path,
    text: str,
    mode: Optional[int] = None,
    force_inplace: bool = False,
) -> None:
    filename = os.path.abspath(str(path))
    directory = os.path.dirname(filename) or "."
    os.makedirs(directory, exist_ok=True)

    old_stat = None
    try:
        old_stat = os.stat(filename)
    except OSError:
        pass
    if mode is None:
        mode = stat.S_IMODE(old_stat.st_mode) if old_stat else 0o644

    if force_inplace or is_mountpoint(filename):
        with open(filename, "w", encoding="utf-8", errors="surrogateescape", newline="") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        return

    fd, tmp = tempfile.mkstemp(
        prefix=f".{os.path.basename(filename)}.", suffix=".tmp", dir=directory
    )
    try:
        with os.fdopen(fd, "w", encoding="utf-8", errors="surrogateescape", newline="") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        if old_stat is not None and os.geteuid() == 0:
            try:
                os.chown(tmp, old_stat.st_uid, old_stat.st_gid)
            except OSError:
                pass
        os.replace(tmp, filename)
        fsync_dir(directory)
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def read_text(path: Path) -> str:
    with open(path, "r", encoding="utf-8", errors="surrogateescape") as fh:
        return fh.read()


@contextlib.contextmanager
def state_lock():
    global _LOCK_FD, _LOCK_DEPTH
    if _LOCK_DEPTH > 0:
        _LOCK_DEPTH += 1
        try:
            yield
        finally:
            _LOCK_DEPTH -= 1
        return

    os.makedirs(RUN_DIR, mode=0o755, exist_ok=True)
    fd = os.open(str(LOCK_FILE), os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
    except OSError:
        os.close(fd)
        raise
    _LOCK_FD = fd
    _LOCK_DEPTH = 1
    try:
        yield
    finally:
        _LOCK_DEPTH = 0
        _LOCK_FD = None
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        os.close(fd)

