def check_for_ip_updates(interactive: bool = False) -> bool:
    stored_data: Dict[str, Any] = {}
    if METADATA_FILE.exists():
        try:
            stored_data = json.loads(read_text(METADATA_FILE))
        except Exception:
            pass

    update_found = False
    details: List[str] = []

    # 1. Check DNS-AI serial
    try:
        req = urllib.request.Request("https://dns-ai.ru/endpoints.json", headers={"User-Agent": "curl/8.0"})
        with urllib.request.urlopen(req, timeout=3.0) as res:
            dns_ai_json = json.loads(res.read().decode("utf-8"))
        new_serial = dns_ai_json.get("serial", 0)
        old_serial = stored_data.get("dns_ai_serial", 0)
        if new_serial > old_serial and old_serial > 0:
            update_found = True
            details.append(f"DNS-AI: Новая ревизия Serial {new_serial} (было: {old_serial})")
        stored_data["dns_ai_serial"] = new_serial
    except Exception:
        pass

    # 2. Check GeoHide hosts date
    try:
        req = urllib.request.Request(
            "https://geohide.ru/eu/hosts",
            headers={"Range": "bytes=0-300", "User-Agent": "curl/8.0"},
        )
        with urllib.request.urlopen(req, timeout=3.0) as res:
            text = res.read().decode("utf-8", errors="ignore")
        m = re.search(r"Последнее обновление:\s*([^\r\n]+)", text)
        if m:
            new_date = m.group(1).strip()
            old_date = stored_data.get("geohide_eu_date", "")
            if old_date and new_date != old_date:
                update_found = True
                details.append(f"GeoHide: База обновлена от {new_date} (было: {old_date})")
            stored_data["geohide_eu_date"] = new_date
    except Exception:
        pass

    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        atomic_write_text(METADATA_FILE, json.dumps(stored_data, indent=2) + "\n", mode=0o644)
    except Exception:
        pass

    if update_found:
        print(f"\n{C_CYAN}╔════════════════════════════════════════════════════════════════════╗{C_RESET}")
        print(f"{C_CYAN}║               Обнаружено обновление серверов онлайн!               ║{C_RESET}")
        print(f"{C_CYAN}╚════════════════════════════════════════════════════════════════════╝{C_RESET}")
        for d in details:
            print(f"  {C_YELLOW}● {d}{C_RESET}")

        if interactive and sys.stdin.isatty():
            ans = input(f"\n  {C_CYAN}Применить обновленные IP-адреса сейчас? [Y/n]: {C_RESET}").strip()
            if ans.lower() not in ("n", "no"):
                if is_active():
                    enable_dns()
                print(f"{C_GREEN}✓ База адресов успешно синхронизирована!{C_RESET}")
                time.sleep(1.5)
        return True
    return False

