def enable_dns(
    profile: Optional[str] = None,
    custom_ips: Optional[Sequence[str]] = None,
    quiet: bool = False,
) -> bool:
    global QUIET
    prev_quiet = QUIET
    if quiet:
        QUIET = True

    try:
        if profile and profile in PROFILES:
            set_active_profile(profile)

        cur_prof = get_active_profile()
        prof_info = PROFILES[cur_prof]
        tls_name = prof_info["tls_name"]

        say(f"{C_CYAN}--> [DNS-AI & GeoHide] Активация профиля:{C_RESET} {C_BOLD}{prof_info['name']}{C_RESET}")

        if custom_ips:
            v4 = list(custom_ips)
        else:
            v4 = list(prof_info["default_v4"])

        ensure_resolved_active()
        fix_resolv_conf()

        if not write_resolved_conf(v4, tls_name, prof_info.get("default_v6", [])):
            return False

        try:
            LEGACY_CONFIG_FILE.unlink()
        except OSError:
            pass

        with state_lock():
            state = load_state()
            state["profile"] = cur_prof
            nm_apply_ignore_dns(state)
            restart_resolved()

            google_ip = determine_google_sni_ip()
            openai_ip = determine_openai_sni_ip()

            update_hosts_entry(google_ip, openai_ip)
            state["last_google_sni"] = google_ip
            state["last_openai_sni"] = openai_ip
            state["enabled"] = True
            state["dns_v4"] = v4
            save_state(state)

        say(f"{C_GREEN}✓ Защищенный DoT ({tls_name}) активирован глобально!{C_RESET}")
        if google_ip:
            say(f"{C_GREEN}✓ Google AI / Antigravity направлены на:{C_RESET} {C_WHITE}{google_ip}{C_RESET}")
        if openai_ip:
            say(f"{C_GREEN}✓ ChatGPT / Claude AI направлены на:{C_RESET} {C_WHITE}{openai_ip}{C_RESET}")
        return True
    finally:
        QUIET = prev_quiet


def disable_dns(quiet: bool = False) -> bool:
    global QUIET
    prev_quiet = QUIET
    if quiet:
        QUIET = True

    try:
        with state_lock():
            state = load_state()
            for path in (CONFIG_FILE, LEGACY_CONFIG_FILE):
                try:
                    path.unlink()
                except FileNotFoundError:
                    pass
                except OSError as exc:
                    if path == CONFIG_FILE:
                        error(f"Не удалось удалить {CONFIG_FILE}: {short_error(exc)}")
                        return False

            update_hosts_entry("", "")
            revert_interface_dns()
            nm_restore_dns(state.get("nm_connections", []))

            state["nm_connections"] = []
            state["enabled"] = False
            state["last_google_sni"] = ""
            state["last_openai_sni"] = ""
            save_state(state)
            restart_resolved()

        say(f"{C_YELLOW}✓ Шифрованный DNS выключен. Восстановлены стандартные настройки сети.{C_RESET}")
        return True
    finally:
        QUIET = prev_quiet


def toggle_dns() -> bool:
    if is_active():
        return disable_dns()
    return enable_dns()


def cmd_reconcile() -> int:
    global QUIET
    prev_quiet = QUIET
    try:
        QUIET = True
        if not is_active():
            return 0
        with state_lock():
            state = load_state()
            cur_prof = state.get("profile", DEFAULT_PROFILE)
            prof_info = PROFILES.get(cur_prof, PROFILES[DEFAULT_PROFILE])
            v4 = state.get("dns_v4") or prof_info["default_v4"]
            write_resolved_conf(v4, prof_info["tls_name"])
            ensure_resolved_active()
            restart_resolved()
            nm_apply_ignore_dns(state)
            google_ip = state.get("last_google_sni") or determine_google_sni_ip()
            openai_ip = state.get("last_openai_sni") or determine_openai_sni_ip()
            update_hosts_entry(google_ip, openai_ip)
            save_state(state)
        return 0
    except Exception:
        return 0
    finally:
        QUIET = prev_quiet

