C_YELLOW="\e[1;33m"
C_RED="\e[1;31m"
C_BLUE="\e[1;34m"
C_MAGENTA="\e[1;35m"
C_GRAY="\e[0;90m"
C_WHITE="\e[1;37m"

mkdir -p "$CACHE_DIR" 2>/dev/null || true
if [ "$(id -u)" -eq 0 ]; then
    mkdir -p "$STATE_DIR" "$CONFIG_DIR" 2>/dev/null || true
fi

