def is_resolved_active() -> bool:
    if not command_exists("systemctl"):
        return False
    return run_cmd(["systemctl", "is-active", "--quiet", "systemd-resolved"], timeout=5).returncode == 0


def ensure_resolved_active() -> bool:
    if is_resolved_active():
        return True
    if not command_exists("systemctl"):
        return False
    run_cmd(["systemctl", "enable", "--now", "systemd-resolved"], timeout=20)
    return is_resolved_active()


def fix_resolv_conf() -> None:
    stub = "/run/systemd/resolve/stub-resolv.conf"
    if not os.path.exists(stub):
        return
    try:
        if os.path.islink("/etc/resolv.conf") and os.readlink("/etc/resolv.conf") == stub:
            return
        if os.path.exists("/etc/resolv.conf") and not os.path.islink("/etc/resolv.conf"):
            run_cmd(["cp", "-p", "/etc/resolv.conf", "/etc/resolv.conf.dns-ai.bak"], timeout=5)
        try:
            os.unlink("/etc/resolv.conf")
        except FileNotFoundError:
            pass
        os.symlink(stub, "/etc/resolv.conf")
    except OSError:
        pass


def write_resolved_conf(v4: Sequence[str], tls_name: str, v6: Sequence[str] = ()) -> bool:
    entries = [f"{ip}#{tls_name}" for ip in v4 if ip]
    entries.extend(f"{ip}#{tls_name}" for ip in v6 if ip)
    if not entries:
        error("Нет DNS-серверов для конфигурации systemd-resolved.")
        return False
    content = (
        "# DNS-AI & GeoHide — systemd-resolved configuration\n"
        f"# Generated: {time.strftime('%Y-%m-%d %H:%M:%S')}\n"
        "[Resolve]\n"
        "DNS=\n"
        f"DNS={' '.join(entries)}\n"
        "DNSOverTLS=yes\n"
        "Domains=~.\n"
        "FallbackDNS=1.1.1.1 8.8.8.8\n"
        "DNSSEC=no\n"
    )
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        atomic_write_text(CONFIG_FILE, content, mode=0o644)
        return True
    except OSError as exc:
        error(f"Не удалось записать {CONFIG_FILE}: {short_error(exc)}")
        return False


def restart_resolved() -> None:
    if command_exists("systemctl"):
        run_cmd(["systemctl", "restart", "systemd-resolved"], timeout=20)

    # Clear per-interface overrides so Global DoT takes absolute precedence
    if command_exists("ip") and command_exists("resolvectl"):
        res = run_cmd(["ip", "-o", "link", "show", "up"], timeout=5)
        for line in res.stdout.splitlines():
            parts = line.split(": ")
            if len(parts) >= 2:
                dev = parts[1].split("@")[0].strip()
                if dev and not any(dev.startswith(p) for p in ("lo", "docker", "br-", "veth", "dummy")):
                    run_cmd(["resolvectl", "dns", dev, ""], timeout=3)
                    run_cmd(["resolvectl", "domain", dev, ""], timeout=3)
                    run_cmd(["resolvectl", "default-route", dev, "false"], timeout=3)

    if command_exists("resolvectl"):
        run_cmd(["resolvectl", "flush-caches"], timeout=10)


def revert_interface_dns() -> None:
    if command_exists("ip") and command_exists("resolvectl"):
        res = run_cmd(["ip", "-o", "link", "show", "up"], timeout=5)
        for line in res.stdout.splitlines():
            parts = line.split(": ")
            if len(parts) >= 2:
                dev = parts[1].split("@")[0].strip()
                if dev and not any(dev.startswith(p) for p in ("lo", "docker", "br-", "veth", "dummy")):
                    run_cmd(["resolvectl", "revert", dev], timeout=5)


def nm_apply_ignore_dns(state: Dict[str, Any]) -> None:
    if not command_exists("nmcli"):
        return
    if command_exists("systemctl") and run_cmd(["systemctl", "is-active", "--quiet", "NetworkManager"], timeout=5).returncode != 0:
        return

    result = run_cmd(["nmcli", "-t", "-f", "UUID,TYPE,DEVICE", "connection", "show", "--active"], timeout=10)
    if result.returncode != 0:
        return

    known = set(state.get("nm_connections", []))
    for line in result.stdout.splitlines():
        parts = line.split(":")
        if len(parts) < 2:
            continue
        uuid, conn_type = parts[0], parts[1].lower()
        dev = parts[2] if len(parts) > 2 else ""
        if not uuid or conn_type in ("", "loopback", "bridge", "tun", "wireguard", "vpn", "dummy") or "docker" in conn_type:
            continue
        mod = run_cmd(["nmcli", "connection", "modify", uuid, "ipv4.ignore-auto-dns", "yes", "ipv6.ignore-auto-dns", "yes"], timeout=10)
        if mod.returncode == 0:
            known.add(uuid)
            if dev:
                run_cmd(["nmcli", "device", "reapply", dev], timeout=10)
    state["nm_connections"] = sorted(known)


def nm_restore_dns(uuids: Iterable[str]) -> None:
    if not command_exists("nmcli"):
        return
    for uuid in uuids:
        if not uuid:
            continue
        run_cmd(["nmcli", "connection", "modify", uuid, "ipv4.ignore-auto-dns", "no", "ipv6.ignore-auto-dns", "no"], timeout=10)
        dev = run_cmd(["nmcli", "-g", "GENERAL.DEVICES", "connection", "show", uuid], timeout=5).stdout.strip()
        if dev:
            run_cmd(["nmcli", "device", "reapply", dev], timeout=10)

