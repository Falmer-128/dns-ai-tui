set -o pipefail

# ----------------- Privilege Escalation -----------------
# Read-only commands can run without root.
# Modifying commands and interactive TUI auto-elevate with sudo / doas.
case "$1" in
    test|status|check-ip|-h|--help|help)
        ;;
    *)
        if [ "$(id -u)" -ne 0 ]; then
            if command -v sudo >/dev/null 2>&1; then
                exec sudo "$0" "$@"
            elif command -v doas >/dev/null 2>&1; then
                exec doas "$0" "$@"
            else
                echo -e "\e[1;31mОшибка:\e[0m Для выполнения этого действия требуются права root (sudo)."
                exit 1
            fi
        fi
        ;;
esac

# ----------------- Configuration & State Paths -----------------
CONFIG_DIR="/etc/systemd/resolved.conf.d"
CONFIG_FILE="$CONFIG_DIR/dns-ai.conf"
HOSTS_FILE="/etc/hosts"
STATE_DIR="/etc/dns-ai"

if [ "$(id -u)" -eq 0 ] || [ -w "$STATE_DIR" ]; then
    CACHE_DIR="$STATE_DIR"
else
    CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dns-ai"
fi

PROFILE_FILE="$STATE_DIR/profile"
SNI_MODE_FILE="$STATE_DIR/sni_mode"
METADATA_FILE="$CACHE_DIR/metadata.json"
DNS_AI_CACHE="$CACHE_DIR/endpoints_dns_ai.json"
GEOHIDE_CACHE="$CACHE_DIR/endpoints_geohide.json"
SERVICE_NAME="dns-ai.service"

# Terminal Colors
C_RESET="\e[0m"
C_BOLD="\e[1m"
