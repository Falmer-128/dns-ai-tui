def default_state() -> Dict[str, Any]:
    return {
        "version": 2,
        "enabled": False,
        "profile": DEFAULT_PROFILE,
        "sni_mode": "auto",
        "last_google_sni": "",
        "last_openai_sni": "",
        "dns_v4": [],
        "dns_v6": [],
        "nm_connections": [],
        "endpoints": {},
        "metadata": {},
        "updated_at": 0,
    }


def _load_legacy_state() -> Dict[str, Any]:
    state = default_state()
    try:
        prof = read_text(LEGACY_PROFILE_FILE).strip()
        if prof in PROFILES:
            state["profile"] = prof
    except OSError:
        pass
    try:
        mode = read_text(LEGACY_MODE_FILE).strip()
        if mode:
            state["sni_mode"] = mode
    except OSError:
        pass
    try:
        uuids = [l.strip() for l in read_text(LEGACY_NM_FILE).splitlines() if l.strip()]
        state["nm_connections"] = uuids
    except OSError:
        pass
    return state


def load_state() -> Dict[str, Any]:
    try:
        data = json.loads(read_text(STATE_FILE))
    except FileNotFoundError:
        return _load_legacy_state()
    except (OSError, ValueError):
        return default_state()

    if not isinstance(data, dict):
        return default_state()

    state = default_state()
    state.update(data)
    if state.get("profile") not in PROFILES:
        state["profile"] = DEFAULT_PROFILE
    if not isinstance(state.get("sni_mode"), str):
        state["sni_mode"] = "auto"
    for key in ("dns_v4", "dns_v6", "nm_connections"):
        val = state.get(key)
        state[key] = [str(item) for item in val] if isinstance(val, list) else []
    if not isinstance(state.get("metadata"), dict):
        state["metadata"] = {}
    return state


def save_state(state: Dict[str, Any]) -> None:
    state["updated_at"] = int(time.time())
    os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
    payload = json.dumps(state, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    atomic_write_text(STATE_FILE, payload, mode=0o644)


def get_active_profile() -> str:
    return str(load_state().get("profile") or DEFAULT_PROFILE)


def set_active_profile(profile: str) -> None:
    if profile not in PROFILES:
        profile = DEFAULT_PROFILE
    with state_lock():
        state = load_state()
        state["profile"] = profile
        save_state(state)


def get_sni_mode() -> str:
    return str(load_state().get("sni_mode") or "auto").strip()


def set_sni_mode(mode: str) -> None:
    with state_lock():
        state = load_state()
        state["sni_mode"] = mode
        save_state(state)


