def _split_custom_ips(ips: Sequence[str]) -> Tuple[List[str], List[str]]:
    v4: List[str] = []
    v6: List[str] = []
    for ip in ips:
        try:
            addr = ipaddress.ip_address(ip)
        except ValueError:
            continue
        (v4 if addr.version == 4 else v6).append(str(addr))
    return v4, v6


def enable_dns(
    custom_ips: Optional[Sequence[str]] = None,
    endpoint_data: Optional[Dict[str, Any]] = None,
    quiet: bool = False,
) -> bool:
    """Enable DNS-over-TLS, host overrides and NetworkManager cooperation."""
    global QUIET
    previous_quiet = QUIET
    if quiet:
        QUIET = True
    try:
        if custom_ips:
            v4, v6 = _split_custom_ips(custom_ips)
            if not v4 and not v6:
                error("Не указан ни один корректный IP-адрес.")
                return False
            include_v6 = bool(v6)
            say(f"{C_CYAN}--> [DNS-AI] Использование ручных IP:{C_RESET} {' '.join(list(v4) + list(v6))}")
        else:
            data = endpoint_data or get_endpoints()
            v4 = list(data.get("v4", []))[:2]
            v6 = list(data.get("v6", []))[:2]
            say(f"{C_CYAN}--> [DNS-AI] Официальные эндпоинты:{C_RESET} {' '.join(v4)}")
            include_v6 = has_global_v6()

        if not v4 and not v6:
            error("Список DNS-серверов пуст.")
            return False

        ensure_resolved_active()
        fix_resolv_conf()
        if not write_resolved_conf(v4, v6 if include_v6 else []):
            return False

        # Remove the pre-2.0 drop-in so resolved cannot merge both files.
        try:
            LEGACY_CONFIG_FILE.unlink()
        except OSError:
            pass

        with state_lock():
            state = load_state()
            nm_apply_ignore_dns(state)

            restart_resolved()

            sni_ip = determine_sni_ip()
            if sni_ip:
                update_hosts_entry(sni_ip)
                state["last_sni"] = sni_ip
            else:
                update_hosts_entry("")
                state["last_sni"] = ""

            state["enabled"] = True
            state["dns_v4"] = v4
            state["dns_v6"] = v6 if include_v6 else []
            save_state(state)

        if sni_ip:
            say(f"{C_GREEN}✓ DNS-AI ВКЛЮЧЕН с DoT ({TLS_NAME})!{C_RESET}")
            say(f"{C_GREEN}✓ Google AI / Antigravity направлены на SNI-узел:{C_RESET} {C_WHITE}{sni_ip}{C_RESET}")
        else:
            say(f"{C_GREEN}✓ DNS-AI ВКЛЮЧЕН с DoT ({TLS_NAME})!{C_RESET}")
            warn("⚠ Внимание: Ни один SNI-узел Google AI не ответил по TLS. Оверрайд /etc/hosts пропущен.")
        return True
    finally:
        QUIET = previous_quiet


def disable_dns(quiet: bool = False) -> bool:
    """Disable DNS-AI and restore normal system DNS and hosts behaviour."""
    global QUIET
    previous_quiet = QUIET
    if quiet:
        QUIET = True
    try:
        with state_lock():
            state = load_state()
            for config_path in (CONFIG_FILE, LEGACY_CONFIG_FILE):
                try:
                    config_path.unlink()
                except FileNotFoundError:
                    pass
                except OSError as exc:
                    if config_path == CONFIG_FILE:
                        error(f"Не удалось удалить {CONFIG_FILE}: {short_error(exc)}")
                        return False

            update_hosts_entry("")
            nm_restore_dns(state.get("nm_connections", []))
            state["nm_connections"] = []
            state["enabled"] = False
            state["dns_v4"] = []
            state["dns_v6"] = []
            state["last_sni"] = ""
            save_state(state)
            restart_resolved()
        say(f"{C_YELLOW}✓ DNS-AI ВЫКЛЮЧЕН. Восстановлены стандартные настройки DNS и hosts.{C_RESET}")
        return True
    finally:
        QUIET = previous_quiet


def toggle_dns() -> bool:
    if is_active():
        return disable_dns()
    return enable_dns()


def _sni_for_mode_without_probe() -> str:
    """Fast SNI selection for the NetworkManager dispatcher (no TLS probes)."""
    mode = get_sni_mode()
    if mode.startswith("manual:"):
        return mode.split(":", 1)[1].strip()
    if mode == "backup" or mode.startswith("143"):
        return BACKUP_SNI_IP
    if mode == "primary" or mode.startswith("109"):
        return PRIMARY_SNI_IP
    if mode in ("none", "disabled"):
        return ""
    return str(load_state().get("last_sni") or "")


def cmd_reconcile() -> int:
    """Quietly re-apply saved settings after a NetworkManager event."""
    global QUIET
    previous_quiet = QUIET
    try:
        QUIET = True
        if not is_active():
            return 0
        with state_lock():
            state = load_state()
            v4 = [ip for ip in state.get("dns_v4", []) if valid_ip(ip)]
            v6 = [ip for ip in state.get("dns_v6", []) if valid_ip(ip)]
            if (v4 or v6) and write_resolved_conf(v4, v6):
                try:
                    LEGACY_CONFIG_FILE.unlink()
                except OSError:
                    pass
            ensure_resolved_active()
            restart_resolved()
            nm_apply_ignore_dns(state)
            mode = get_sni_mode()
            sni = _sni_for_mode_without_probe()
            if mode not in ("auto",) or sni:
                update_hosts_entry(sni)
            save_state(state)
        return 0
    except Exception:
        # A dispatcher hook must never break the network or print tracebacks.
        return 0
    finally:
        QUIET = previous_quiet

