# ------------------------------------------------------------------------------
# Privilege escalation and command routing
# ------------------------------------------------------------------------------

NO_ROOT_COMMANDS = {"test", "status", "-h", "--help", "help"}
ROOT_COMMANDS = {
    "on", "enable", "start",
    "off", "disable", "stop",
    "toggle",
    "reconcile",
    "autostart",
    "set-sni",
    "set-ip",
    "update", "refresh",
    "upgrade", "self-update", "update-app",
    "reset",
    "tui", "menu", "",
}


def needs_root(command: str) -> bool:
    if command in NO_ROOT_COMMANDS:
        return False
    return command in ROOT_COMMANDS


def escalate() -> int:
    """Re-exec through sudo/doas when root privileges are required."""
    if os.environ.get("DNS_AI_NO_ESCALATE") == "1" or os.environ.get("DNS_AI_ESCALATED") == "1":
        print(f"{C_RED}Ошибка:{C_RESET} Для выполнения этого действия требуются права root (sudo).", file=sys.stderr)
        return 1
    tool = shutil.which("sudo") or shutil.which("doas")
    if not tool:
        print(f"{C_RED}Ошибка:{C_RESET} Для выполнения этого действия требуются права root (sudo).", file=sys.stderr)
        return 1

    script = os.path.abspath(sys.argv[0])
    args = sys.argv[1:]
    env_tool = shutil.which("env")
    prefix: List[str] = [tool]
    if env_tool:
        prefix.extend([env_tool, "DNS_AI_ESCALATED=1"])
    if os.access(script, os.X_OK):
        target = [script, *args]
    else:
        target = [sys.executable, script, *args]

    try:
        os.execv(tool, prefix + target)
    except OSError as exc:
        print(f"{C_RED}Ошибка:{C_RESET} Не удалось повысить права: {short_error(exc)}", file=sys.stderr)
        return 1
    return 1


def main(argv: Sequence[str]) -> int:
    command = argv[0] if argv else ""
    args = list(argv[1:])

    if command in ("on", "enable", "start"):
        return cmd_on(args)
    if command in ("off", "disable", "stop"):
        is_quiet = any(a in ("--quiet", "-q", "--service", "-s") for a in args)
        return 0 if disable_dns(quiet=is_quiet) else 1
    if command == "toggle":
        return 0 if toggle_dns() else 1
    if command == "reconcile":
        return cmd_reconcile()
    if command == "status":
        show_status()
        return 0
    if command == "test":
        run_full_test()
        return 0
    if command == "autostart":
        return cmd_autostart(args)
    if command == "set-sni":
        return cmd_set_sni(args)
    if command == "set-ip":
        return cmd_set_ip(args)
    if command in ("update", "refresh"):
        return cmd_update()
    if command in ("upgrade", "self-update", "update-app"):
        return self_update()
    if command == "reset":
        return reset_all("✓ Сброс завершен.")
    if command in ("-h", "--help", "help"):
        show_help()
        return 0
    if command in ("tui", "menu", ""):
        return main_tui()

    show_help()
    return 1


def entry() -> int:
    """Top-level guard: escalation, clean interrupts, no tracebacks."""
    try:
        argv = list(sys.argv[1:])
        command = argv[0] if argv else ""
        if needs_root(command) and os.geteuid() != 0:
            return escalate()
        return main(argv)
    except KeyboardInterrupt:
        if sys.stdout.isatty():
            clear_screen()
        return 130
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except OSError:
            pass
        return 0
    except Exception as exc:  # pragma: no cover - final safety net
        if os.environ.get("DNS_AI_DEBUG"):
            raise
        print(f"{C_RED}✗ Ошибка:{C_RESET} {short_error(exc)}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(entry())
