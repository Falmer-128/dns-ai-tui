def is_autostart_enabled() -> bool:
    if not command_exists("systemctl"):
        return False
    return run_cmd(["systemctl", "is-enabled", SERVICE_NAME], timeout=5).stdout.strip() == "enabled"


def ensure_service_file() -> None:
    if SERVICE_PATH.is_file():
        return
    try:
        SERVICE_PATH.parent.mkdir(parents=True, exist_ok=True)
        atomic_write_text(SERVICE_PATH, SERVICE_CONTENT, mode=0o644)
        run_cmd(["systemctl", "daemon-reload"], timeout=10)
    except OSError as exc:
        error(f"Не удалось создать {SERVICE_PATH}: {short_error(exc)}")


def manage_autostart(action: str = "status") -> int:
    action = (action or "status").lower()
    if action not in ("enable", "disable", "toggle", "status"):
        print("Использование: dns-ai autostart <enable|disable|toggle|status>")
        return 1
    if not command_exists("systemctl"):
        error("systemctl не найден. Автозагрузка systemd недоступна.")
        return 1
    if action == "toggle":
        action = "disable" if is_autostart_enabled() else "enable"
    if action in ("enable", "disable"):
        ensure_service_file()
        result = run_cmd(["systemctl", action, SERVICE_NAME], timeout=15)
        run_cmd(["systemctl", "daemon-reload"], timeout=10)
        if result.returncode != 0:
            error(f"systemctl {action} {SERVICE_NAME}: {short_error(result.stderr or result.stdout)}")
            return 1
        if action == "enable":
            print(f"{C_GREEN}✓ Служба {SERVICE_NAME} успешно добавлена в автозагрузку!{C_RESET}")
        else:
            print(f"{C_YELLOW}✓ Служба {SERVICE_NAME} успешно убрана из автозагрузки!{C_RESET}")
        return 0
    if is_autostart_enabled():
        print(f"Автозагрузка: {C_GREEN}ВКЛЮЧЕНА (systemd enabled){C_RESET}")
    else:
        print(f"Автозагрузка: {C_YELLOW}ОТКЛЮЧЕНА (systemd disabled){C_RESET}")
    return 0

